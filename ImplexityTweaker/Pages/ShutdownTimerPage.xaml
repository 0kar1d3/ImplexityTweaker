<Page x:Class="ImplexityTweaker.Pages.ShutdownTimerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:ImplexityTweaker.Localization"
      Title="Shutdown"
      Foreground="{DynamicResource App.Text}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <TextBlock Text="{loc:Loc 'Таймер выключения'}" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{loc:Loc 'Планирование выключения или перезагрузки по таймеру.'}"
                       Style="{StaticResource PageDescriptionText}"
                       Margin="0,8,0,16" />

            <ui:Card Padding="20" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource App.SurfaceAlt}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Width="44" Height="44"
                            VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="Clock32" FontSize="22" Foreground="{DynamicResource App.IconAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{loc:Loc 'Таймер выключения'}" Style="{StaticResource ItemTitleText}" />
                        <TextBlock Text="{loc:Loc 'Запланируйте автоматическое выключение или перезагрузку компьютера.'}"
                                   Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" Margin="0,4,0,14" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{loc:Loc 'Через (мин):'}" Style="{StaticResource ItemTitleText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="MinutesBox" Width="80" Text="30" FontSize="13" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="{loc:Loc 'Выключить ПК'}" Appearance="Primary" Click="Shutdown_Click" Padding="20,8" Margin="0,0,8,0" />
                            <ui:Button Content="{loc:Loc 'Перезагрузка'}" Appearance="Secondary" Click="Reboot_Click" Padding="20,8" Margin="0,0,8,0" />
                            <ui:Button Content="{loc:Loc 'Отмена'}" Appearance="Transparent" Click="Abort_Click" Padding="20,8" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
