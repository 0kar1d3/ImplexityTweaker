<Page x:Class="ImplexityTweaker.Pages.ContextMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:ImplexityTweaker.Localization"
      Title="ContextMenu"
      Foreground="{DynamicResource App.Text}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <TextBlock Text="{loc:Loc 'Контекстное меню'}" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{loc:Loc 'Настройка пунктов контекстного меню Windows. Некоторые изменения требуют перезапуска проводника.'}"
                       Style="{StaticResource PageDescriptionText}"
                       Margin="0,8,0,16" />

            <ui:Card Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="{loc:Loc 'Основные параметры'}" Style="{StaticResource CardHeaderText}" Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ClipboardBulletListLtr20" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Классическое контекстное меню'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Возвращает привычное меню Windows 10 без значков-сокращений.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="OldContextMenuToggle" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ClockArrowDownload24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Убрать задержку контекстного меню'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Меню открывается мгновенно, без искусственной паузы.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="RemoveContextDelayToggle" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="WindowDevTools20" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Открыть в терминале'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Добавляет пункт для открытия папки в Windows Terminal.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="OpenInTerminalToggle" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="{loc:Loc 'Дополнительно'}" Style="{StaticResource CardHeaderText}" Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ChannelShare24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Поделиться'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Добавляет пункт «Поделиться» в контекстное меню.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="ShareToggle" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowCounterclockwise16" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Восстановить прежнюю версию'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Добавляет пункт «Восстановить прежнюю версию».'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="RestoreOldVersionToggle" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="CloudArrowUp24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Отправить'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Добавляет пункт «Отправить» в контекстное меню.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="SendToggle" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="CopyAdd20" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Копировать как путь'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Добавляет пункт «Копировать как путь».'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="CopyPathToggle" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="TabDesktop24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Закрепить на начальном экране'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Добавляет пункт для закрепления на начальном экране.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="PinStartToggle" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Desktop32" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Закрепить на панели задач'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Добавляет пункт для закрепления на панели задач.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="PinTaskbarToggle" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Button Content="{loc:Loc 'Применить'}"
                       Appearance="Primary"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,10"
                       Click="Apply_Click"
                       Padding="20,8" />
        </StackPanel>
    </ScrollViewer>
</Page>
