<Page x:Class="ImplexityTweaker.Pages.FunSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:ImplexityTweaker.Localization"
      Title="FunSettings"
      Foreground="{DynamicResource App.Text}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,28" MaxWidth="980">
            <TextBlock Text="{loc:Loc 'Фановые настройки'}" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{loc:Loc 'Безопасные и обратимые визуальные шутки, подмена данных и приколы в Windows.'}"
                       Style="{StaticResource PageDescriptionText}"
                       Margin="0,6,0,18" />

            <!-- ===== 1. Название процессора ===== -->
            <ui:Card Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource SettingIconBox}">
                            <ui:SymbolIcon Symbol="HardDrive20" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Процессор (CPU)'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Изменяет название процессора, отображаемое в диспетчере задач. Изменения вступают в силу сразу, но сбрасываются после перезагрузки ПК.'}"
                                       Style="{StaticResource ItemDescriptionText}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Название процессора'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock x:Name="CurrentCpuText"
                                       Style="{StaticResource ItemDescriptionText}" />
                        </StackPanel>
                    </Grid>

                    <TextBox x:Name="CpuNameBox"
                             Margin="0,0,0,12"
                             Padding="10,8"
                             FontSize="13" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:Button Content="{loc:Loc 'Применить название CPU'}"
                                   Appearance="Primary"
                                   Click="ApplyCpu_Click"
                                   Padding="20,8"
                                   Margin="0,0,8,0" />
                        <ui:Button Content="{loc:Loc 'Сбросить'}"
                                   Appearance="Secondary"
                                   Click="ResetCpu_Click"
                                   Padding="20,8" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- ===== 2. Текст при входе в Windows ===== -->
            <ui:Card Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource SettingIconBox}">
                            <ui:SymbolIcon Symbol="LockClosed24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Текст при входе в Windows'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Показывает сообщение с заголовком и текстом перед экраном входа в систему (legalnoticecaption / legalnoticetext).'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{loc:Loc 'Заголовок окна'}" Style="{StaticResource ItemTitleText}" Margin="0,0,0,6" />
                    <TextBox x:Name="LoginNoticeCaptionBox"
                             Margin="0,0,0,12"
                             Padding="10,8"
                             FontSize="13" />

                    <TextBlock Text="{loc:Loc 'Текст сообщения'}" Style="{StaticResource ItemTitleText}" Margin="0,0,0,6" />
                    <TextBox x:Name="LoginNoticeTextBox"
                             Margin="0,0,0,12"
                             Padding="10,8"
                             FontSize="13"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="68" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:Button Content="{loc:Loc 'Применить сообщение'}"
                                   Appearance="Primary"
                                   Click="ApplyLoginNotice_Click"
                                   Padding="20,8"
                                   Margin="0,0,8,0" />
                        <ui:Button Content="{loc:Loc 'Сбросить'}"
                                   Appearance="Secondary"
                                   Click="ResetLoginNotice_Click"
                                   Padding="20,8" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- ===== 3. Поворот экрана на 180 градусов ===== -->
            <ui:Card Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource SettingIconBox}">
                            <ui:SymbolIcon Symbol="Desktop32" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Поворот экрана на 180°'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Переворачивает основной монитор вверх ногами. Для безопасности экран автоматически вернётся в обычное положение через 10 секунд, если вы не нажмёте «Оставить 180°».'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="RotationStatusText"
                               Style="{StaticResource ItemDescriptionText}"
                               Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="{loc:Loc 'Повернуть на 180°'}"
                                   Appearance="Primary"
                                   Click="Rotate180_Click"
                                   Padding="20,8"
                                   Margin="0,0,8,0" />
                        <ui:Button x:Name="KeepRotationButton"
                                   Content="{loc:Loc 'Оставить 180°'}"
                                   Appearance="Secondary"
                                   Click="KeepRotation_Click"
                                   Padding="20,8"
                                   Margin="0,0,8,0"
                                   Visibility="Collapsed" />
                        <ui:Button Content="{loc:Loc 'Вернуть обычно (0°)'}"
                                   Appearance="Secondary"
                                   Click="RotateReset_Click"
                                   Padding="20,8" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- ===== 4. Фейковый BSOD ===== -->
            <ui:Card>
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource SettingIconBox}">
                            <ui:SymbolIcon Symbol="Warning24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Фейковый BSOD (Синий экран)'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Открывает полноэкранную симуляцию синего экрана смерти Windows с анимированным прогрессом. Не вредит системе — закрывается клавишей Esc или двойным кликом.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{loc:Loc 'Код остановки (необязательно)'}" Style="{StaticResource ItemTitleText}" Margin="0,0,0,6" />
                    <TextBox x:Name="BsodStopCodeBox"
                             Text="CRITICAL_PROCESS_DIED"
                             Margin="0,0,0,12"
                             Padding="10,8"
                             FontSize="13" />

                    <ui:Button Content="{loc:Loc 'Запустить фейковый BSOD'}"
                               Appearance="Primary"
                               Click="LaunchFakeBsod_Click"
                               HorizontalAlignment="Left"
                               Padding="20,8" />
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>
