<Page x:Class="ImplexityTweaker.Pages.AutostartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:ImplexityTweaker.Localization"
      Title="Autostart"
      Foreground="{DynamicResource App.Text}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <TextBlock Text="{loc:Loc 'Автозагрузка'}" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{loc:Loc 'Программы, запускающиеся вместе с Windows. Включайте и отключайте их одним переключателем, не редактируя реестр вручную.'}"
                       Style="{StaticResource PageDescriptionText}" Margin="0,8,0,16" />

            <!-- Добавление записи -->
            <ui:Card Padding="20" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="10" Width="44" Height="44" VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="Add32" FontSize="22" Foreground="{DynamicResource App.IconAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{loc:Loc 'Добавить программу в автозагрузку'}" Style="{StaticResource ItemTitleText}" />
                        <TextBlock Text="{loc:Loc 'Нажмите «Выбрать программу…» и укажите файл .exe, .lnk, .bat или .cmd — он сразу добавится в автозагрузку.'}"
                                   Style="{StaticResource ItemDescriptionText}" Margin="0,4,0,12" />
                        <ui:Button Content="{loc:Loc 'Выбрать программу…'}" Appearance="Primary" Click="Browse_Click"
                                   Padding="18,7" HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- Список записей -->
            <ui:Card Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="{loc:Loc 'Программы при запуске Windows'}" Style="{StaticResource CardHeaderText}" Margin="0,0,0,4" />
                    <TextBlock Text="{loc:Loc 'Переключатель включает или отключает запуск программы при входе в Windows.'}"
                               Style="{StaticResource ItemDescriptionText}" Margin="0,0,0,10" />

                    <ui:ProgressRing x:Name="LoadingIndicator" IsIndeterminate="True" Width="32" Height="32"
                                     HorizontalAlignment="Center" Margin="0,4,0,4" Visibility="Collapsed" />

                    <ItemsControl x:Name="EntryList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8,0,8">
                                    <Grid.ToolTip>
                                        <StackPanel MaxWidth="480">
                                            <TextBlock Text="{loc:Loc 'Путь к файлу'}" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <TextBlock Text="{Binding Command}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid.ToolTip>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Image Source="{Binding Icon}" Width="32" Height="32" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitleText}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="4" Padding="7,1">
                                                <TextBlock Text="{Binding SourceText}" FontSize="11" Foreground="{DynamicResource App.TextMuted}" />
                                            </Border>
                                            <TextBlock Text="{Binding StateText}" FontSize="11" Margin="10,0,0,0"
                                                       Foreground="{DynamicResource App.Accent}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>

                                    <ui:ToggleSwitch Grid.Column="2" Tag="{Binding}" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                     Checked="Toggle_Changed" Unchecked="Toggle_Changed"
                                                     VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="CountText" Style="{StaticResource ItemDescriptionText}" Margin="0,8,0,0" />
                </StackPanel>
            </ui:Card>

            <!-- Аудит автозагрузки -->
            <ui:Card Padding="20" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource App.SurfaceAlt}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Width="44" Height="44"
                            VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="TaskListLtr24" FontSize="22" Foreground="{DynamicResource App.IconAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{loc:Loc 'Что лишнее в автозагрузке'}" Style="{StaticResource ItemTitleText}" />
                        <TextBlock Text="{loc:Loc 'Проверяет записи автозагрузки: файлы из временных папок и несуществующие пути.'}"
                                   Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" Margin="0,4,0,14" />
                        <ui:Button Content="{loc:Loc 'Проверить автозагрузку'}" Appearance="Primary" Click="Audit_Click"
                                   HorizontalAlignment="Left" Padding="20,8" />
                        <StackPanel x:Name="AuditHost" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
