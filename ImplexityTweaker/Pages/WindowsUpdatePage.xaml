<Page x:Class="ImplexityTweaker.Pages.WindowsUpdatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:ImplexityTweaker.Localization"
      Title="WindowsUpdate"
      Foreground="{DynamicResource App.Text}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <TextBlock Text="{loc:Loc 'Windows Update'}" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{loc:Loc 'Включение и отключение обновлений Windows. Требуются права администратора.'}"
                       Style="{StaticResource PageDescriptionText}"
                       Margin="0,8,0,16" />

            <ui:Card Padding="20" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource App.SurfaceAlt}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Width="44" Height="44"
                            VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="CloudSync24" FontSize="22"
                                       Foreground="{DynamicResource App.IconAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,12,0">
                        <TextBlock x:Name="StateTitleText" Text="{loc:Loc 'Проверяем состояние…'}"
                                   Style="{StaticResource ItemTitleText}" TextWrapping="Wrap" />
                        <TextBlock x:Name="StateDetailText" Text=""
                                   Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <ui:Button Grid.Column="2" Content="{loc:Loc 'Обновить'}" Appearance="Secondary"
                               Click="Refresh_Click" Padding="16,6" VerticalAlignment="Top" />
                </Grid>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="{loc:Loc 'Что сделать'}" Style="{StaticResource CardHeaderText}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowSyncCheckmark24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Включить обновления (как в Windows)'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Служба запускается по требованию: обновления скачиваются и устанавливаются как обычно.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:Button Grid.Column="2" Content="{loc:Loc 'Включить'}" Appearance="Primary" Click="Enable_Click"
                                   Padding="16,6" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ShieldDismiss24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Отключить обновления'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Служба обновлений и планировщик обновлений останавливаются. Обновления безопасности тоже перестанут устанавливаться.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:Button Grid.Column="2" Content="{loc:Loc 'Отключить'}" Appearance="Secondary" Click="Disable_Click"
                                   Padding="16,6" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{loc:Loc 'Отключение можно отменить в любой момент. Если Windows снова включит службу, просто нажмите «Отключить» ещё раз.'}"
                               Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <ui:Button Content="{loc:Loc 'Открыть параметры Windows Update'}" Appearance="Transparent"
                               Click="OpenSettings_Click" HorizontalAlignment="Left" Padding="20,8" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
