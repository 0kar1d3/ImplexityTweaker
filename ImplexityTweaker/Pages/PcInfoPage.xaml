<Page x:Class="ImplexityTweaker.Pages.PcInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="PcInfo"
      Foreground="{DynamicResource App.Text}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">

            <!-- Шапка -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Информация о ПК" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Сводные характеристики вашего устройства: система, процессор, память и комплектующие."
                               Style="{StaticResource PageDescriptionText}" />
                </StackPanel>

                <ui:Button Grid.Column="1" Content="Обновить данные" Appearance="Primary" Click="Refresh_Click"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Padding="20,8" FontSize="13" />
            </Grid>

            <!-- Индикатор загрузки данных -->
            <ui:ProgressRing x:Name="LoadingIndicator" IsIndeterminate="True"
                             Width="32" Height="32" Margin="0,16,0,0"
                             HorizontalAlignment="Center" Visibility="Collapsed" />

            <!-- Краткая сводка -->
            <Border Margin="0,16,0,0" Style="{StaticResource FluentBlockBorder}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Height="44" VerticalAlignment="Center"
                            Background="{DynamicResource App.Accent}" CornerRadius="2" />
                    <StackPanel Margin="16,0,0,0">
                        <TextBlock Text="Компьютер" FontSize="12" Foreground="{DynamicResource App.TextMuted}" />
                        <TextBlock x:Name="SummaryMachine" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0" Text="—" />
                        <TextBlock Text="Пользователь" FontSize="12" Foreground="{DynamicResource App.TextMuted}" Margin="0,8,0,0" />
                        <TextBlock x:Name="SummaryUser" FontSize="14" Margin="0,2,0,0" Text="—" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Сетка карточек характеристик -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Левая колонка -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource App.ContentBorder}" Padding="18,16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Операционная система" Style="{StaticResource ItemTitleText}" Margin="0,0,0,8" />
                            <TextBlock x:Name="OsCard" Text="—" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource App.TextMuted}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource App.ContentBorder}" Padding="18,16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Процессор" Style="{StaticResource ItemTitleText}" Margin="0,0,0,8" />
                            <TextBlock x:Name="CpuCard" Text="—" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource App.TextMuted}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource App.ContentBorder}" Padding="18,16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Видеокарта" Style="{StaticResource ItemTitleText}" Margin="0,0,0,8" />
                            <TextBlock x:Name="GpuCard" Text="—" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource App.TextMuted}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource App.ContentBorder}" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="Оперативная память" Style="{StaticResource ItemTitleText}" Margin="0,0,0,8" />
                            <TextBlock x:Name="MemoryCard" Text="—" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource App.TextMuted}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Правая колонка -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource App.ContentBorder}" Padding="18,16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Материнская плата" Style="{StaticResource ItemTitleText}" Margin="0,0,0,8" />
                            <TextBlock x:Name="SystemCard" Text="—" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource App.TextMuted}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource App.ContentBorder}" Padding="18,16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="BIOS / UEFI" Style="{StaticResource ItemTitleText}" Margin="0,0,0,8" />
                            <TextBlock x:Name="BiosCard" Text="—" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource App.TextMuted}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource App.ContentBorder}" Padding="18,16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Накопители" Style="{StaticResource ItemTitleText}" Margin="0,0,0,8" />
                            <TextBlock x:Name="DiskCard" Text="—" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource App.TextMuted}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource App.ContentBorder}" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="Сеть" Style="{StaticResource ItemTitleText}" Margin="0,0,0,8" />
                            <TextBlock x:Name="NetworkCard" Text="—" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource App.TextMuted}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>