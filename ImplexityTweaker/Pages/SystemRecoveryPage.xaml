<Page x:Class="ImplexityTweaker.Pages.SystemRecoveryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:ImplexityTweaker.Localization"
      Title="SystemRecovery"
      Foreground="{DynamicResource App.Text}">

    <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,28" MaxWidth="980">
            <TextBlock Text="{loc:Loc 'Система и восстановление'}" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{loc:Loc 'Точки восстановления, сжатие системы и параметры телеметрии.'}"
                       Style="{StaticResource PageDescriptionText}"
                       Margin="0,6,0,18" />

            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource App.SurfaceAlt}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Width="44" Height="44"
                            VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="ArrowSyncCheckmark24" FontSize="22" Foreground="{DynamicResource App.IconAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{loc:Loc 'Снимок перед изменениями'}" Style="{StaticResource ItemTitleText}" />
                        <TextBlock Text="{loc:Loc 'Сохраняет реестр, службы, задачи планировщика, hosts, схему питания, загрузчик и настройки приложения. Если что-то сломается — одна кнопка вернёт всё как было.'}"
                                   Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" Margin="0,4,0,14" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:Button Content="{loc:Loc 'Создать снимок'}" Appearance="Primary" Click="TweakSnapshot_Click" Padding="20,8" Margin="0,0,8,0" />
                            <ui:Button Content="{loc:Loc 'Обновить список'}" Appearance="Secondary" Click="TweakSnapshotRefresh_Click" Padding="20,8" />
                        </StackPanel>
                        <TextBlock Text="{loc:Loc 'Хранятся последние 10 снимков, самые старые удаляются автоматически.'}"
                                   Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <Border Background="{DynamicResource App.WarningSoft}"
                                BorderBrush="{DynamicResource App.Warning}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8"
                                Margin="0,0,0,12">
                            <TextBlock Text="{loc:Loc 'Дисклеймер (BCD): при создании и откате снимка выполняется экспорт/импорт конфигурации загрузчика Windows (bcdedit). Если между снимком и откатом менялась разметка диска или загрузочные записи, импорт BCD может нарушить загрузку ОС.'}"
                                       Foreground="{DynamicResource App.Text}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Border>
                        <StackPanel x:Name="BackupHost" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource App.SurfaceAlt}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Width="44" Height="44"
                            VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="Storage24" FontSize="22" Foreground="{DynamicResource App.IconAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{loc:Loc 'Сжатие и глубокая очистка системы'}" Style="{StaticResource ItemTitleText}" />
                        <TextBlock Text="{loc:Loc 'Сжатие системы уменьшает занимаемое место на диске, а глубокая очистка удаляет устаревшие файлы и кэш обновлений Windows.'}"
                                   Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <TextBlock x:Name="UpdateCacheSizeText" Style="{StaticResource ItemDescriptionText}" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="{loc:Loc 'Включить сжатие системы (CompactOS)'}" Appearance="Primary" Click="Compact_Click" Padding="20,8" Margin="0,0,8,0" />
                            <ui:Button Content="{loc:Loc 'Очистить кэш обновлений'}" Appearance="Secondary" Click="CleanWinSxS_Click" Padding="20,8" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- ===== Гибернация (hiberfil.sys) и Файл подкачки (pagefile.sys) ===== -->
            <ui:Card>
                <StackPanel>
                    <TextBlock Text="{loc:Loc 'Гибернация и файл подкачки'}" Style="{StaticResource CardHeaderText}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingIconBox}">
                            <ui:SymbolIcon Symbol="HardDrive20" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Режим гибернации'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock x:Name="HibernationStatusText"
                                       Text="{loc:Loc 'Отключение режима гибернации сразу освобождает от 6 до 32 ГБ на системном диске.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="HibernationToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="HibernationToggle_Toggled" Unchecked="HibernationToggle_Toggled" />
                    </Grid>

                    <Separator Margin="0,0,0,14" Background="{DynamicResource App.Border}" />

                    <StackPanel>
                        <TextBlock Text="{loc:Loc 'Настройка файла подкачки'}" Style="{StaticResource ItemTitleText}" />
                        <TextBlock x:Name="PagefileStatusText" Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" Margin="0,4,0,12" />

                        <ComboBox x:Name="PagefileModeCombo" Width="320" HorizontalAlignment="Left" FontSize="13"
                                  Margin="0,0,0,12" SelectionChanged="PagefileModeCombo_SelectionChanged" />

                        <StackPanel x:Name="PagefileCustomPanel" Orientation="Vertical" Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{loc:Loc 'Исходный размер (МБ):'}" Style="{StaticResource ItemDescriptionText}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ui:TextBox x:Name="PagefileMinBox" Width="110" FontSize="13" Margin="0,0,18,0" Text="4096" />
                                <TextBlock Text="{loc:Loc 'Максимальный размер (МБ):'}" Style="{StaticResource ItemDescriptionText}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ui:TextBox x:Name="PagefileMaxBox" Width="110" FontSize="13" Text="8192" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="{loc:Loc '4–8 ГБ'}" Appearance="Secondary" Padding="12,5" FontSize="12" Margin="0,0,6,0" Tag="4096:8192" Click="PagefilePreset_Click" />
                                <ui:Button Content="{loc:Loc '8–16 ГБ'}" Appearance="Secondary" Padding="12,5" FontSize="12" Margin="0,0,6,0" Tag="8192:16384" Click="PagefilePreset_Click" />
                                <ui:Button Content="{loc:Loc '16 ГБ (Фикс.)'}" Appearance="Secondary" Padding="12,5" FontSize="12" Tag="16384:16384" Click="PagefilePreset_Click" />
                            </StackPanel>
                        </StackPanel>

                        <ui:Button Content="{loc:Loc 'Применить параметры подкачки'}" Appearance="Primary"
                                   Click="ApplyPagefile_Click" HorizontalAlignment="Left" Padding="20,8" />

                        <Border Background="{DynamicResource App.WarningSoft}"
                                BorderBrush="{DynamicResource App.Warning}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8"
                                Margin="0,12,0,0">
                            <TextBlock Text="{loc:Loc 'Дисклеймер: полное отключение файла подкачки (pagefile.sys) может привести к вылетам игр и приложений при нехватке ОЗУ и отключает запись дампов памяти при BSOD. Отключение гибернации удаляет hiberfil.sys и делает невозможным режим «Гибернация» (и Fast Startup).'}"
                                       Foreground="{DynamicResource App.Text}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- powercfg /batteryreport -->
            <ui:Card>
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc 'Батарея и питание'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Для ноутбуков — анализ заводской и текущей ёмкости аккумулятора, процента износа и количества циклов зарядки.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                            <ui:Button Content="{loc:Loc 'Сформировать отчёт'}" Appearance="Primary"
                                       Click="GenerateBatteryReport_Click" Padding="16,7" Margin="0,0,8,0" />
                            <ui:Button x:Name="OpenBatteryHtmlBtn" Content="{loc:Loc 'Открыть подробный отчёт'}" Appearance="Secondary"
                                       Click="OpenBatteryHtml_Click" Padding="14,7" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="BatterySummaryText"
                               Text="{loc:Loc 'Нажмите «Сформировать отчёт», чтобы проверить износ и ёмкость аккумулятора.'}"
                               Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </ui:Card>

            <TextBlock Text="{loc:Loc 'Телеметрия и конфиденциальность'}" Style="{StaticResource CardHeaderText}" Margin="0,0,0,10" />
            <Border Style="{StaticResource FluentBlockBorder}" Padding="0">
                <Frame x:Name="TelemetryFrame" NavigationUIVisibility="Hidden" PreviewMouseWheel="TelemetryFrame_PreviewMouseWheel" />
            </Border>

            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource App.SurfaceAlt}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Width="44" Height="44"
                            VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="ArrowTrendingSettings24" FontSize="22" Foreground="{DynamicResource App.IconAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{loc:Loc 'Диагностика в один клик'}" Style="{StaticResource ItemTitleText}" />
                        <TextBlock Text="{loc:Loc 'Последовательно проверит образ системы, диск, целостность файлов и загрузчик. Может занять несколько минут.'}"
                                   Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" Margin="0,4,0,14" />
                        <ui:Button Content="{loc:Loc 'Запустить диагностику'}" Appearance="Primary" Click="RunDiagnostics_Click"
                                   HorizontalAlignment="Left" Padding="20,8" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource App.SurfaceAlt}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Width="44" Height="44"
                            VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="HardDrive20" FontSize="22" Foreground="{DynamicResource App.IconAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{loc:Loc 'Состояние накопителей (SMART)'}" Style="{StaticResource ItemTitleText}" />
                        <TextBlock Text="{loc:Loc 'Открывает отдельное окно с оценкой здоровья накопителей, температурой и износом (SMART).'}"
                                   Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" Margin="0,4,0,14" />
                        <ui:Button Content="{loc:Loc 'Открыть состояние дисков'}" Appearance="Secondary" Click="SmartDisks_Click"
                                   HorizontalAlignment="Left" Padding="20,8" />
                    </StackPanel>
                </Grid>
            </ui:Card>
            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource App.SurfaceAlt}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Width="44" Height="44"
                            VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="ArrowTrendingWrench24" FontSize="22" Foreground="{DynamicResource App.IconAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{loc:Loc 'Драйверы'}" Style="{StaticResource ItemTitleText}" />
                        <TextBlock Text="{loc:Loc 'Проверяет проблемные устройства и показывает версии видеодрайверов.'}"
                                   Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" Margin="0,4,0,14" />
                        <ui:Button Content="{loc:Loc 'Проверить драйверы'}" Appearance="Secondary" Click="Drivers_Click"
                                   HorizontalAlignment="Left" Padding="20,8" />
                        <StackPanel x:Name="DriversHost" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource App.SurfaceAlt}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Width="44" Height="44"
                            VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="BoxSearch24" FontSize="22" Foreground="{DynamicResource App.IconAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{loc:Loc 'Анализ места на диске'}" Style="{StaticResource ItemTitleText}" />
                        <TextBlock Text="{loc:Loc 'Считает размеры папок и крупных файлов, чтобы найти, что занимает место.'}"
                                   Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" Margin="0,4,0,14" />
                        <ui:TextBox x:Name="AnalyzePathBox" FontSize="13" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="{loc:Loc 'Анализировать'}" Appearance="Primary" Click="Analyze_Click" Padding="20,8" Margin="0,0,8,0" />
                            <ui:Button Content="{loc:Loc 'Отмена'}" Appearance="Secondary" Click="CancelAnalyze_Click" Padding="20,8" />
                        </StackPanel>
                        <StackPanel x:Name="DiskAnalysisHost" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource App.SurfaceAlt}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Width="44" Height="44"
                            VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="ArrowClockwise28" FontSize="22" Foreground="{DynamicResource App.IconAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{loc:Loc 'Точки восстановления Windows'}" Style="{StaticResource ItemTitleText}" />
                        <TextBlock Text="{loc:Loc 'Дополнительная страховка на случай проблем с самой Windows: драйверы, системные файлы, загрузка. Откат вернёт всю систему к выбранной точке и потребует перезагрузку.'}"
                                   Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" Margin="0,4,0,12" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:Button Content="{loc:Loc 'Создать точку восстановления'}" Appearance="Primary" Click="CreateRestorePoint_Click" Padding="20,8" Margin="0,0,8,8" />
                            <ui:Button Content="{loc:Loc 'Обновить список'}" Appearance="Secondary" Click="RestorePointList_Click" Padding="20,8" Margin="0,0,8,8" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:Button Content="{loc:Loc 'Включить защиту системы'}" Appearance="Secondary" Click="EnableProtection_Click" Padding="20,8" Margin="0,0,8,8" />
                            <ui:Button Content="{loc:Loc 'Открыть «Защита системы»'}" Appearance="Transparent" Click="OpenSysRestore_Click" Padding="20,8" Margin="0,0,0,8" />
                        </StackPanel>

                        <TextBlock x:Name="RestoreStatusText" Text="{loc:Loc 'Чтение точек восстановления…'}"
                                   Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <StackPanel x:Name="RestoreListHost" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </ui:Card>


        </StackPanel>
    </ScrollViewer>
</Page>
