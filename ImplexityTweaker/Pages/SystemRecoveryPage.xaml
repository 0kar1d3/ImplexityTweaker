<Page x:Class="ImplexityTweaker.Pages.SystemRecoveryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="SystemRecovery"
      Foreground="{DynamicResource App.Text}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <TextBlock Text="Система и восстановление" FontSize="32" FontWeight="Bold" />
            <TextBlock Text="Точки восстановления, сжатие системы и подробные параметры телеметрии."
                       Foreground="{DynamicResource App.TextMuted}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,16" />

            <ui:Card Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Восстановление" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
                    <ui:Button Content="Открыть «Защита системы»" Appearance="Secondary" Click="OpenSysRestore_Click" HorizontalAlignment="Left" Padding="20,8" Margin="0,0,0,8" />
                    <ui:Button Content="Создать точку восстановления" Appearance="Primary" Click="CreateRestorePoint_Click" HorizontalAlignment="Left" Padding="20,8" Margin="0,0,0,8" />
                    <ui:Button Content="Управление дисками" Appearance="Transparent" Click="DiskMgmt_Click" HorizontalAlignment="Left" Padding="20,8" Margin="0,0,0,8" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Сжатие и обслуживание" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
                    <TextBlock Text="CompactOS уменьшает занимаемое место на системном разделе (может занять время)."
                               FontSize="12"
                               Foreground="{DynamicResource App.TextMuted}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />
                    <ui:Button Content="Включить сжатие системы (CompactOS)" Appearance="Primary" Click="Compact_Click" HorizontalAlignment="Left" Padding="20,8" />
                </StackPanel>
            </ui:Card>

            <TextBlock Text="Телеметрия и конфиденциальность" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
            <Border Style="{StaticResource FluentBlockBorder}" Padding="0">
                <Frame x:Name="TelemetryFrame" NavigationUIVisibility="Hidden" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>