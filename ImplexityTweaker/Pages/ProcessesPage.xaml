<Page x:Class="ImplexityTweaker.Pages.ProcessesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Processes"
      Foreground="{DynamicResource App.Text}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Управление процессами" FontSize="32" FontWeight="Bold" />
            <TextBlock Text="Просмотр запущенных процессов, сортировка по потреблению ОЗУ и завершение одним нажатием."
                       Foreground="{DynamicResource App.TextMuted}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />
        </StackPanel>

        <!-- Toolbar -->
        <ui:Card Grid.Row="1" Padding="20" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <ui:Button x:Name="RefreshButton" Content="Обновить список" Appearance="Primary" Click="Refresh_Click" Padding="20,8" Margin="0,0,8,0" />

                <TextBox x:Name="SearchBox" Width="220" FontSize="13" VerticalContentAlignment="Center"
                         ToolTip="Поиск по имени процесса" Margin="8,0,8,0"
                         TextChanged="SearchBox_TextChanged" />

                <ComboBox x:Name="SortCombo" Width="150" FontSize="13" VerticalContentAlignment="Center"
                          SelectedIndex="0"
                          SelectionChanged="SortCombo_SelectionChanged">
                    <ComboBoxItem Content="ОЗУ (убыв.)" />
                    <ComboBoxItem Content="ОЗУ (возр.)" />
                    <ComboBoxItem Content="Имя (А-Я)" />
                    <ComboBoxItem Content="Имя (Я-А)" />
                </ComboBox>
            </StackPanel>
        </ui:Card>

        <!-- Process list -->
        <ui:Card Grid.Row="2" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:ProgressRing x:Name="LoadingIndicator" Grid.Row="0" IsIndeterminate="True" Width="32" Height="32"
                                 HorizontalAlignment="Center" Margin="0,8,0,8" Visibility="Collapsed" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ProcessList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Image Source="{Binding Icon}" Width="24" Height="24"
                                           VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{Binding Pid, StringFormat=PID: {0}}" FontSize="11"
                                                   Foreground="{DynamicResource App.TextMuted}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding RamText}" FontWeight="SemiBold"
                                               FontSize="14" VerticalAlignment="Center" Margin="0,0,16,0" />

                                    <Button Grid.Column="3" Content="Завершить"
                                            Padding="12,6" FontSize="12"
                                            Tag="{Binding Pid}"
                                            Click="KillProcess_Click"
                                            Background="#C42B1C" Foreground="White"
                                            BorderThickness="0" Cursor="Hand"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="CountText" Grid.Row="2" Foreground="{DynamicResource App.TextMuted}"
                           FontSize="12" Margin="0,10,0,0" />
            </Grid>
        </ui:Card>
    </Grid>
</Page>
