<Page x:Class="ImplexityTweaker.Pages.ProcessesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:ImplexityTweaker.Localization"
      Title="Processes"
      Foreground="{DynamicResource App.Text}">

    <Page.Resources>
        <!-- Кнопка завершения процесса -->
        <Style x:Key="KillButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E13B2A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Строка процесса: иконка, имя с PID, полоска памяти, кнопка завершения -->
        <DataTemplate x:Key="ProcessRowTemplate">
            <Border Margin="0,0,0,8" Padding="12,10"
                    Background="{DynamicResource App.SurfaceAlt}"
                    BorderBrush="{DynamicResource App.Border}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource App.Background}" CornerRadius="8"
                            Width="36" Height="36" VerticalAlignment="Center">
                        <Image Source="{Binding Icon}" Width="22" Height="22" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitleText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding PidText}" Style="{StaticResource ItemDescriptionText}" TextTrimming="CharacterEllipsis" />
                        <Border Height="4" Width="180" CornerRadius="2" Margin="0,6,0,0" HorizontalAlignment="Left"
                                Background="{DynamicResource App.Background}">
                            <Border Width="{Binding BarWidth}" HorizontalAlignment="Left"
                                    Background="{DynamicResource App.Accent}" CornerRadius="2" />
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding RamText}" Style="{StaticResource ItemTitleText}"
                               VerticalAlignment="Center" Margin="0,0,14,0" />

                    <Button Grid.Column="3" Style="{StaticResource KillButtonStyle}"
                            Content="{loc:Loc 'Завершить'}" Tag="{Binding}" Click="KillProcess_Click" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{loc:Loc 'Управление процессами'}" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{loc:Loc 'Активные и фоновые процессы: сортировка по потреблению ОЗУ и завершение одним нажатием.'}"
                       Style="{StaticResource PageDescriptionText}"
                       Margin="0,8,0,0" />
        </StackPanel>

        <!-- Toolbar -->
        <ui:Card Grid.Row="1" Padding="20" Margin="0,0,0,15">
            <WrapPanel Orientation="Horizontal">
                <ui:Button x:Name="RefreshButton" Content="{loc:Loc 'Обновить список'}" Appearance="Primary" Click="Refresh_Click" Padding="20,8" Margin="0,4,8,4" />

                <TextBox x:Name="SearchBox" Width="200" Height="34" FontSize="13" VerticalContentAlignment="Center"
                         ToolTip="{loc:Loc 'Поиск по имени процесса'}" Margin="0,4,8,4"
                         TextChanged="SearchBox_TextChanged" />

                <ComboBox x:Name="SortCombo" Width="150" Height="34" FontSize="13" VerticalContentAlignment="Center"
                          SelectedIndex="0" Margin="0,4,8,4"
                          ToolTip="{loc:Loc 'Сортировка'}"
                          SelectionChanged="SortCombo_SelectionChanged">
                    <ComboBoxItem Content="{loc:Loc 'ОЗУ (убыв.)'}" />
                    <ComboBoxItem Content="{loc:Loc 'ОЗУ (возр.)'}" />
                    <ComboBoxItem Content="{loc:Loc 'Имя (А-Я)'}" />
                    <ComboBoxItem Content="{loc:Loc 'Имя (Я-А)'}" />
                </ComboBox>

                <ComboBox x:Name="GroupCombo" Width="195" Height="34" FontSize="13" VerticalContentAlignment="Center"
                          SelectedIndex="0" Margin="0,4,0,4"
                          ToolTip="{loc:Loc 'Как показывать процессы с одинаковым именем'}"
                          SelectionChanged="GroupCombo_SelectionChanged">
                    <ComboBoxItem Content="{loc:Loc 'Сгруппировать по .exe'}" />
                    <ComboBoxItem Content="{loc:Loc 'Показывать все'}" />
                </ComboBox>
            </WrapPanel>
        </ui:Card>
        <!-- Process list -->
        <ui:Card Grid.Row="2" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:ProgressRing x:Name="LoadingIndicator" Grid.Row="0" IsIndeterminate="True" Width="32" Height="32"
                                 HorizontalAlignment="Center" Margin="0,8,0,8" Visibility="Collapsed" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Активные приложения -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Background="{DynamicResource App.SurfaceAlt}"
                                    BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                    CornerRadius="9" Width="32" Height="32" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="WindowDevTools20" FontSize="17" Foreground="{DynamicResource App.IconAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc 'Активные приложения'}" Style="{StaticResource ItemTitleText}" />
                                <TextBlock Text="{loc:Loc 'Процессы с открытым окном.'}" Style="{StaticResource ItemDescriptionText}" />
                            </StackPanel>

                            <Border Grid.Column="2" Background="{DynamicResource App.SurfaceAlt}"
                                    BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                    CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                                <TextBlock x:Name="ActiveCountText" Style="{StaticResource ItemDescriptionText}" Text="0" />
                            </Border>
                        </Grid>

                        <ItemsControl x:Name="ActiveList" ItemTemplate="{StaticResource ProcessRowTemplate}" />

                        <TextBlock x:Name="ActiveEmptyText" Text="{loc:Loc 'Нет активных приложений.'}"
                                   Style="{StaticResource ItemDescriptionText}" Margin="0,2,0,10" Visibility="Collapsed" />

                        <!-- Фоновые процессы -->
                        <Grid Margin="0,14,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Background="{DynamicResource App.SurfaceAlt}"
                                    BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                    CornerRadius="9" Width="32" Height="32" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="System24" FontSize="17" Foreground="{DynamicResource App.IconAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc 'Фоновые процессы'}" Style="{StaticResource ItemTitleText}" />
                                <TextBlock Text="{loc:Loc 'Работают без открытого окна.'}" Style="{StaticResource ItemDescriptionText}" />
                            </StackPanel>

                            <Border Grid.Column="2" Background="{DynamicResource App.SurfaceAlt}"
                                    BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                    CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                                <TextBlock x:Name="BackgroundCountText" Style="{StaticResource ItemDescriptionText}" Text="0" />
                            </Border>
                        </Grid>

                        <ItemsControl x:Name="BackgroundList" ItemTemplate="{StaticResource ProcessRowTemplate}" />

                        <TextBlock x:Name="BackgroundEmptyText" Text="{loc:Loc 'Нет фоновых процессов.'}"
                                   Style="{StaticResource ItemDescriptionText}" Margin="0,2,0,10" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>

                <TextBlock x:Name="CountText" Grid.Row="2" Style="{StaticResource ItemDescriptionText}"
                           FontSize="12" Margin="0,10,0,0" />
            </Grid>
        </ui:Card>
    </Grid>
</Page>
