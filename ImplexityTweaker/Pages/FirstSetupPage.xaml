<Page x:Class="ImplexityTweaker.Pages.FirstSetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:ImplexityTweaker.Localization"
      Title="FirstSetup"
      Foreground="{DynamicResource App.Text}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <TextBlock Text="{loc:Loc 'Быстрая настройка Windows'}" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{loc:Loc 'Используйте переключатели, чтобы выбрать настройки для автоматического применения.'}"
                       Style="{StaticResource PageDescriptionText}"
                       Margin="0,8,0,16" />

            <ui:Card Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="{loc:Loc 'Проводник и обновления'}" Style="{StaticResource CardHeaderText}" Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Показывать скрытые файлы и папки'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Отображает файлы и папки с атрибутом «Скрытый».'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="ShowHiddenToggle" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="DocumentFolder24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Показывать расширения файлов'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Отображает расширения имён файлов в Проводнике.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="ShowExtensionsToggle" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Home24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Открывать в проводнике «Этот ПК» вместо «Главная»'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'При запуске Проводника открывает «Этот компьютер» вместо «Главной».'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="ThisPcToggle" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="CloudSync24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Приостановить службу Windows Update'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Приостанавливает автоматическое обновление Windows.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="PauseWuToggle" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Desktop32" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Показывать значок «Этот компьютер» на рабочем столе'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Добавляет значок «Этот компьютер» на рабочий стол.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="ThisPcDesktopToggle" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Document24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Убрать « — ярлык» в имени новых ярлыков'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Убирает суффикс « — ярлык» у новых создаваемых ярлыков.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="NoShortcutSuffixToggle" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="TabDesktop24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Скрыть кнопки «Просмотр задач» и «Виджеты»'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Убирает кнопку просмотра задач и виджеты с панели задач.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="HideTaskViewWidgetsToggle" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="DismissCircle24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Кнопка «Завершить задачу» на панели задач (Windows 11)'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Добавляет кнопку завершения задачи на панель задач в Windows 11.'}"
                                       Style="{StaticResource ItemDescriptionText}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="EndTaskToggle" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Lightbulb24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Уменьшить рекламу в меню «Пуск» и на панели задач'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Снижает количество рекламных предложений и рекомендаций в меню «Пуск».'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="ReduceAdsToggle" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Keyboard24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Выключить залипание клавиш'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Отключает режим «залипания клавиш», который может случайно срабатывать от пяти нажатий Shift (часто мешает в играх).'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="DisableStickyKeysToggle" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="{loc:Loc 'Дополнительные компоненты'}" Style="{StaticResource CardHeaderText}" Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Games24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Установить DirectPlay'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Компонент для запуска старых игр из 2000-х.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:Button Grid.Column="2" Content="{loc:Loc 'Установить'}" Appearance="Secondary" Click="InstallDirectPlay_Click" Padding="16,6" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="CodeText20" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Установить .NET Framework 2.0, 3.0, 3.5'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Совместимость со старыми приложениями.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:Button Grid.Column="2" Content="{loc:Loc 'Установить'}" Appearance="Secondary" Click="InstallNetFx35_Click" Padding="16,6" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Camera24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Включить старый просмотрщик фото'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Возвращает классический просмотрщик фотографий Windows.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:Button Grid.Column="2" Content="{loc:Loc 'Установить'}" Appearance="Secondary" Click="InstallOldPhotoViewer_Click" Padding="16,6" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="{loc:Loc 'Игровая оптимизация'}" Style="{StaticResource CardHeaderText}" Margin="0,0,0,8" />
                    <TextBlock Text="{loc:Loc 'Применяется сразу при запуске быстрой настройки: игровой режим Windows и парковка ядер.'}"
                               Style="{StaticResource ItemDescriptionText}" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Games24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Игровой режим Windows'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Windows выделяет ресурсы активной игре.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="QuickGameModeToggle" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ClockToolbox20" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Отключить парковку ядер'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Держит все ядра процессора активными — меньше микрофризов в играх.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="QuickCoreParkingToggle" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="{loc:Loc 'Страховка перед изменениями'}" Style="{StaticResource CardHeaderText}" Margin="0,0,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowSyncCheckmark24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Создать снимок настроек перед применением'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Сохранит реестр и настройки, чтобы можно было вернуть всё назад (раздел «Система и восстановление»).'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="QuickSnapshotToggle" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="{loc:Loc 'Запустить быструю настройку'}" Appearance="Primary" Click="Run_Click" MinWidth="260" Padding="20,8" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
