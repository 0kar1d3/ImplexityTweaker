<Page x:Class="ImplexityTweaker.Pages.FirstSetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="FirstSetup"
      Foreground="{DynamicResource App.Text}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <TextBlock Text="Быстрая настройка Windows" FontSize="32" FontWeight="Bold" />
            <TextBlock Text="Используйте переключатели, чтобы выбрать настройки для автоматического применения."
                       Foreground="{DynamicResource App.TextMuted}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,16" />

            <ui:Card Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Показывать скрытые файлы и папки" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Отображает файлы и папки с атрибутом «Скрытый»."
                                       FontSize="12" Foreground="{DynamicResource App.TextMuted}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="ShowHiddenToggle" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Показывать расширения файлов" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Отображает расширения имён файлов в Проводнике."
                                       FontSize="12" Foreground="{DynamicResource App.TextMuted}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="ShowExtensionsToggle" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Открывать в проводнике «Этот ПК» вместо «Главная»" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="При запуске Проводника открывает «Этот компьютер» вместо «Главной»."
                                       FontSize="12" Foreground="{DynamicResource App.TextMuted}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="ThisPcToggle" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Приостановить службу Windows Update" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Приостанавливает автоматическое обновление Windows."
                                       FontSize="12" Foreground="{DynamicResource App.TextMuted}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="PauseWuToggle" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Показывать значок «Этот компьютер» на рабочем столе" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Добавляет значок «Этот компьютер» на рабочий стол."
                                       FontSize="12" Foreground="{DynamicResource App.TextMuted}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="ThisPcDesktopToggle" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Убрать « — ярлык» в имени новых ярлыков" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Убирает суффикс « — ярлык» у новых создаваемых ярлыков."
                                       FontSize="12" Foreground="{DynamicResource App.TextMuted}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="NoShortcutSuffixToggle" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Скрыть кнопки «Просмотр задач» и «Виджеты»" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Убирает кнопку просмотра задач и виджеты с панели задач."
                                       FontSize="12" Foreground="{DynamicResource App.TextMuted}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="HideTaskViewWidgetsToggle" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Уменьшить рекламу в меню «Пуск» и на панели задач" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Снижает количество рекламных предложений и рекомендаций в меню «Пуск»."
                                       FontSize="12" Foreground="{DynamicResource App.TextMuted}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="ReduceAdsToggle" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Дополнительные компоненты" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Установить DirectPlay" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ui:Button Content="Установить" Appearance="Secondary" Click="InstallDirectPlay_Click" VerticalAlignment="Center" Padding="16,6" Margin="14,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Установить .NET Framework 2.0, 3.0, 3.5" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <ui:Button Content="Установить" Appearance="Secondary" Click="InstallNetFx35_Click" VerticalAlignment="Center" Padding="16,6" Margin="14,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Включить старый просмотрщик фото" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ui:Button Content="Установить" Appearance="Secondary" Click="InstallOldPhotoViewer_Click" VerticalAlignment="Center" Padding="16,6" Margin="14,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="Запустить быструю настройку" Appearance="Primary" Click="Run_Click" MinWidth="260" Padding="20,8" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>