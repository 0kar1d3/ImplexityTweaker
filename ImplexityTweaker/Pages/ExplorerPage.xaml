<Page x:Class="ImplexityTweaker.Pages.ExplorerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Explorer"
      Foreground="{DynamicResource App.Text}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <TextBlock Text="Проводник и Рабочий стол" FontSize="32" FontWeight="Bold" />
            <TextBlock Text="Параметры отображения и поведения проводника и ярлыков на рабочем столе."
                       Foreground="{DynamicResource App.TextMuted}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,16" />

            <ui:Card Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Показывать скрытые файлы и папки" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Отображает файлы и папки с атрибутом «Скрытый» в Проводнике."
                                       FontSize="12" Foreground="{DynamicResource App.TextMuted}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="HiddenToggle" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Показывать защищённые системные файлы" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Показывает системные файлы и папки, защищённые Windows."
                                       FontSize="12" Foreground="{DynamicResource App.TextMuted}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="SystemToggle" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Показывать расширения файлов" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Отображает расширения имён файлов в Проводнике."
                                       FontSize="12" Foreground="{DynamicResource App.TextMuted}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="ExtToggle" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Открывать «Этот компьютер» вместо «Главная»" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="При запуске Проводника открывает «Этот компьютер» вместо «Главной»."
                                       FontSize="12" Foreground="{DynamicResource App.TextMuted}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="ThisPcToggle" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <ui:Button Content="Обновить" Appearance="Secondary" Click="Refresh_Click" Padding="20,8" Margin="0,0,8,0" />
                        <ui:Button Content="Применить" Appearance="Primary" Click="Apply_Click" Padding="20,8" Margin="0,0,8,0" />
                        <ui:Button Content="Перезапустить проводник" Appearance="Transparent" Click="RestartExplorer_Click" Padding="20,8" Margin="8,0,0,0" />
                    </StackPanel>
                    <ui:Button Content="Сбросить к значениям по умолчанию"
                               Appearance="Transparent"
                               HorizontalAlignment="Left"
                               Margin="0,10,0,0"
                               Click="ResetDefaults_Click"
                               Padding="20,8" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>