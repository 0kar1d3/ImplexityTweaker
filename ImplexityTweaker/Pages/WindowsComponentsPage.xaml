<Page x:Class="ImplexityTweaker.Pages.WindowsComponentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:ImplexityTweaker.Localization"
      Title="Components"
      Foreground="{DynamicResource App.Text}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <TextBlock Text="{loc:Loc 'Компоненты Windows'}" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{loc:Loc 'Включение и отключение компонентов Windows через DISM и стандартные средства системы.'}"
                       Style="{StaticResource PageDescriptionText}"
                       Margin="0,8,0,16" />

            <!-- Быстрые ссылки на системные средства -->
            <TextBlock Text="{loc:Loc 'Быстрые ссылки'}" Style="{StaticResource CardHeaderText}" Margin="0,0,0,10" />

            <UniformGrid Columns="3" Margin="0,0,0,15">
                <ui:Card Padding="18" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Background="{DynamicResource App.SurfaceAlt}"
                                BorderBrush="{DynamicResource App.Border}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Width="44" Height="44"
                                HorizontalAlignment="Left">
                            <ui:SymbolIcon Symbol="System24" FontSize="22" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Grid.Row="1" Text="{loc:Loc 'Классические компоненты'}" FontSize="15" FontWeight="SemiBold"
                                   Margin="0,12,0,6" />

                        <TextBlock Grid.Row="2" Text="{loc:Loc 'Запуск классической оснастки включения и отключения компонентов Windows.'}"
                                   Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />

                        <ui:Button Grid.Row="3" Content="{loc:Loc 'Открыть'}" Appearance="Secondary"
                                   Click="OptionalFeatures_Click" HorizontalAlignment="Stretch" Margin="0,14,0,0" />
                    </Grid>
                </ui:Card>

                <ui:Card Padding="18" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Background="{DynamicResource App.SurfaceAlt}"
                                BorderBrush="{DynamicResource App.Border}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Width="44" Height="44"
                                HorizontalAlignment="Left">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="22" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Grid.Row="1" Text="{loc:Loc 'Программы и компоненты'}" FontSize="15" FontWeight="SemiBold"
                                   Margin="0,12,0,6" />

                        <TextBlock Grid.Row="2" Text="{loc:Loc 'Классическая панель управления установленными программами (appwiz.cpl).'}"
                                   Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />

                        <ui:Button Grid.Row="3" Content="{loc:Loc 'Открыть'}" Appearance="Secondary"
                                   Click="Appwiz_Click" HorizontalAlignment="Stretch" Margin="0,14,0,0" />
                    </Grid>
                </ui:Card>

                <ui:Card Padding="18" Margin="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Background="{DynamicResource App.SurfaceAlt}"
                                BorderBrush="{DynamicResource App.Border}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Width="44" Height="44"
                                HorizontalAlignment="Left">
                            <ui:SymbolIcon Symbol="AppsListDetail24" FontSize="22" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Grid.Row="1" Text="{loc:Loc 'Дополнительные компоненты Win 10/11'}" FontSize="15" FontWeight="SemiBold"
                                   Margin="0,12,0,6" />

                        <TextBlock Grid.Row="2" Text="{loc:Loc 'Параметры Windows с дополнительными функциями (ms-settings:optionalfeatures).'}"
                                   Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />

                        <ui:Button Grid.Row="3" Content="{loc:Loc 'Открыть'}" Appearance="Secondary"
                                   Click="OptionalFeaturesSettings_Click" HorizontalAlignment="Stretch" Margin="0,14,0,0" />
                    </Grid>
                </ui:Card>
            </UniformGrid>

            <!-- Популярные компоненты -->
            <TextBlock Text="{loc:Loc 'Популярные компоненты'}" Style="{StaticResource CardHeaderText}" Margin="0,0,0,10" />

            <ui:Card Padding="20" Margin="0,0,0,15">
                <StackPanel>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="CodeText20" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc '.NET Framework 3.5'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Поддержка старых приложений и игр, которым требуется .NET Framework 3.5.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="NetFx3Toggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="NetFx3Toggle_Toggled" Unchecked="NetFx3Toggle_Toggled" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="WindowDevTools20" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Подсистема Windows для Linux (WSL)'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Запуск дистрибутивов Linux прямо в Windows через WSL.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="WslToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="WslToggle_Toggled" Unchecked="WslToggle_Toggled" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="WindowShield20" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Песочница Windows'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Изолированная среда для безопасного запуска непроверенных программ и файлов.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="SandboxToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="SandboxToggle_Toggled" Unchecked="SandboxToggle_Toggled" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Games24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'DirectPlay'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Устаревший игровой API — позволяет запускать старые игры из 2000-х.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="DirectPlayToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="DirectPlayToggle_Toggled" Unchecked="DirectPlayToggle_Toggled" />
                    </Grid>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Cube24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Hyper-V'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Платформа виртуализации Microsoft для запуска виртуальных машин.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="HyperVToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="HyperVToggle_Toggled" Unchecked="HyperVToggle_Toggled" />
                    </Grid>

                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
