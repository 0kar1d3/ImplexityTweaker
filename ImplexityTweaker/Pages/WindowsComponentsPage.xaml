<Page x:Class="ImplexityTweaker.Pages.WindowsComponentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Components"
      Foreground="{DynamicResource App.Text}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <TextBlock Text="Компоненты Windows" FontSize="32" FontWeight="Bold" />
            <TextBlock Text="Включение и отключение компонентов через стандартные средства системы."
                       Foreground="{DynamicResource App.TextMuted}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,16" />

            <ui:Card Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <ui:Button Content="Открыть «Компоненты Windows»" Appearance="Primary" Click="OptionalFeatures_Click" HorizontalAlignment="Left" Padding="20,8" Margin="0,0,0,8" />
                    <ui:Button Content="Программы и компоненты (appwiz.cpl)" Appearance="Secondary" Click="Appwiz_Click" HorizontalAlignment="Left" Padding="20,8" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>