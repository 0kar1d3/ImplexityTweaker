<Page x:Class="ImplexityTweaker.Pages.OverlayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:ImplexityTweaker.Localization"
      Title="ImplexityOverlay"
      Foreground="{DynamicResource App.Text}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,28" MaxWidth="980">
            <TextBlock Text="ImplexityOverlay" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{loc:Loc 'Поверх-игровой мониторинг FPS, времени кадра, загрузки комплектующих и температур в реальном времени.'}"
                       Style="{StaticResource PageDescriptionText}"
                       Margin="0,6,0,18" />

            <!-- ===== Управление и горячая клавиша ===== -->
            <ui:Card>
                <StackPanel>
                    <TextBlock Text="{loc:Loc 'Управление оверлеем'}" Style="{StaticResource CardHeaderText}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingIconBox}">
                            <ui:SymbolIcon Symbol="Desktop32" FontSize="19" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Включить ImplexityOverlay'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Отображает прозрачный для кликов HUD поверх игр в оконном и полноэкранном без рамок режимах без инъекции в процесс.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="OverlayEnabledToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingIconBox}">
                            <ui:SymbolIcon Symbol="Rocket24" FontSize="19" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Автозапуск оверлея при старте твикера'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Сразу включает мониторинг после открытия Implexity Tweaker или запуска в трее.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="AutoStartToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingIconBox}">
                            <ui:SymbolIcon Symbol="Keyboard24" FontSize="19" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Горячая клавиша переключения в игре'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Позволяет быстро скрывать и возвращать оверлей прямо во время игры.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="HotkeyCombo" Grid.Column="2" Width="180" FontSize="13" VerticalAlignment="Center"
                                  SelectionChanged="AnySelectionChanged" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- ===== Отображаемые метрики ===== -->
            <ui:Card>
                <StackPanel>
                    <TextBlock Text="{loc:Loc 'Отображаемые показатели'}" Style="{StaticResource CardHeaderText}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingIconBox}">
                            <ui:SymbolIcon Symbol="Games24" FontSize="19" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Счётчик FPS и время кадра'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Точный замер частоты кадров активного окна игры и времени рендера кадра в миллисекундах.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ShowFrametimeCheck" Content="{loc:Loc 'Время кадра'}" Margin="0,0,12,0"
                                      VerticalAlignment="Center" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
                            <CheckBox x:Name="ShowOnePercentCheck" Content="1% Low" Margin="0,0,14,0"
                                      VerticalAlignment="Center" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
                            <ui:ToggleSwitch x:Name="ShowFpsToggle" VerticalAlignment="Center"
                                             Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingIconBox}">
                            <ui:SymbolIcon Symbol="System24" FontSize="19" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Процессор (CPU)'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Текущая нагрузка в процентах и температура процессора.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ShowCpuTempCheck" Content="{loc:Loc 'Температура'}" Margin="0,0,14,0"
                                      VerticalAlignment="Center" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
                            <ui:ToggleSwitch x:Name="ShowCpuToggle" VerticalAlignment="Center"
                                             Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingIconBox}">
                            <ui:SymbolIcon Symbol="Layer24" FontSize="19" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Видеокарта (GPU)'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Загрузка графического процессора и его температура.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ShowGpuTempCheck" Content="{loc:Loc 'Температура'}" Margin="0,0,14,0"
                                      VerticalAlignment="Center" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
                            <ui:ToggleSwitch x:Name="ShowGpuToggle" VerticalAlignment="Center"
                                             Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingIconBox}">
                            <ui:SymbolIcon Symbol="Storage24" FontSize="19" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Оперативная память (RAM)'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Занятый объём в гигабайтах и процент использования ОЗУ.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="ShowRamToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SettingIconBox}">
                            <ui:SymbolIcon Symbol="WindowDevTools20" FontSize="19" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Показывать имя активной игры'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Выводит название запущенного процесса сверху оверлея.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="ShowProcessToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- ===== Внешний вид и положение ===== -->
            <ui:Card>
                <StackPanel>
                    <TextBlock Text="{loc:Loc 'Внешний вид и расположение'}" Style="{StaticResource CardHeaderText}" Margin="0,0,0,12" />

                    <TextBlock Text="{loc:Loc 'Вариант внешнего вида'}" Style="{StaticResource ItemTitleText}" />
                    <TextBlock Text="{loc:Loc 'Выберите один из четырёх стилей отображения игрового оверлея.'}"
                               Style="{StaticResource ItemDescriptionText}" Margin="0,2,0,10" />

                    <UniformGrid Columns="4" Margin="0,0,0,16">
                        <!-- 1. Классический -->
                        <Border x:Name="StyleCardClassic" Tag="Classic" Margin="0,0,6,0" Padding="10"
                                CornerRadius="8" BorderThickness="1.5" Cursor="Hand"
                                Background="{DynamicResource App.SurfaceAlt}" BorderBrush="{DynamicResource App.Border}"
                                MouseLeftButtonUp="StyleCard_MouseLeftButtonUp">
                            <StackPanel>
                                <Border Height="52" CornerRadius="6" Background="#FF0D1422" BorderBrush="#4494A3B8" BorderThickness="1"
                                        Padding="8,0" Margin="0,0,0,8">
                                    <Border CornerRadius="4" Background="#CC0A101B" BorderBrush="#5594A3B8" BorderThickness="1"
                                            Padding="7,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="FPS " FontSize="9" FontWeight="SemiBold" Foreground="#94A3B8" />
                                            <TextBlock Text="144" FontSize="9" FontWeight="Bold" Foreground="#4ADE80" />
                                            <Border Width="1" Height="9" Background="#4494A3B8" Margin="5,0" />
                                            <TextBlock Text="CPU " FontSize="9" Foreground="#94A3B8" />
                                            <TextBlock Text="32%" FontSize="9" FontWeight="Bold" Foreground="#F8FAFC" />
                                        </StackPanel>
                                    </Border>
                                </Border>
                                <TextBlock Text="{loc:Loc 'Классический'}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Loc 'Стандартная карточка'}" FontSize="10.5" Foreground="{DynamicResource App.TextMuted}"
                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- 2. Прозрачный текст (RivaTuner-стиль) -->
                        <Border x:Name="StyleCardTelemetry" Tag="TelemetryText" Margin="3,0" Padding="10"
                                CornerRadius="8" BorderThickness="1.5" Cursor="Hand"
                                Background="{DynamicResource App.SurfaceAlt}" BorderBrush="{DynamicResource App.Border}"
                                MouseLeftButtonUp="StyleCard_MouseLeftButtonUp">
                            <StackPanel>
                                <Border Height="52" CornerRadius="6" Background="#FF111827" BorderBrush="#4494A3B8" BorderThickness="1"
                                        Padding="10,5" Margin="0,0,0,8">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="GPU " FontSize="8.5" FontWeight="Bold" Foreground="#4ADE80" Width="26" />
                                            <TextBlock Text="68°C  24%" FontSize="8.5" FontWeight="Bold" Foreground="#FF9F43" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                            <TextBlock Text="CPU " FontSize="8.5" FontWeight="Bold" Foreground="#60A5FA" Width="26" />
                                            <TextBlock Text="72°C  35%" FontSize="8.5" FontWeight="Bold" Foreground="#FF9F43" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                            <TextBlock Text="FPS " FontSize="8.5" FontWeight="Bold" Foreground="#FB7185" Width="26" />
                                            <TextBlock Text="172 FPS" FontSize="8.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{loc:Loc 'Телеметрия'}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Loc 'Без фона, как RTSS'}" FontSize="10.5" Foreground="{DynamicResource App.TextMuted}"
                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- 3. Закруглённый -->
                        <Border x:Name="StyleCardRounded" Tag="RoundedGlass" Margin="3,0" Padding="10"
                                CornerRadius="8" BorderThickness="1.5" Cursor="Hand"
                                Background="{DynamicResource App.SurfaceAlt}" BorderBrush="{DynamicResource App.Border}"
                                MouseLeftButtonUp="StyleCard_MouseLeftButtonUp">
                            <StackPanel>
                                <Border Height="52" CornerRadius="6" Background="#FF0D1422" BorderBrush="#4494A3B8" BorderThickness="1"
                                        Padding="6,0" Margin="0,0,0,8">
                                    <Border CornerRadius="13" Background="#DD131D31" BorderBrush="#60FFFFFF" BorderThickness="1"
                                            Padding="7,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Border CornerRadius="7" Background="#24FFFFFF" Padding="5,1" Margin="0,0,4,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="4" Height="4" Fill="#4ADE80" Margin="0,0,3,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="144" FontSize="9" FontWeight="Bold" Foreground="#4ADE80" />
                                                </StackPanel>
                                            </Border>
                                            <Ellipse Width="4" Height="4" Fill="#38BDF8" Margin="2,0,3,0" VerticalAlignment="Center" />
                                            <TextBlock Text="32%" FontSize="9" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                            <Ellipse Width="4" Height="4" Fill="#818CF8" Margin="4,0,3,0" VerticalAlignment="Center" />
                                            <TextBlock Text="64%" FontSize="9" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Border>
                                <TextBlock Text="{loc:Loc 'Закруглённый'}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Loc 'Мягкая капсула'}" FontSize="10.5" Foreground="{DynamicResource App.TextMuted}"
                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- 4. Шкалы нагрузки -->
                        <Border x:Name="StyleCardBars" Tag="GamingBars" Margin="6,0,0,0" Padding="10"
                                CornerRadius="8" BorderThickness="1.5" Cursor="Hand"
                                Background="{DynamicResource App.SurfaceAlt}" BorderBrush="{DynamicResource App.Border}"
                                MouseLeftButtonUp="StyleCard_MouseLeftButtonUp">
                            <StackPanel>
                                <Border Height="52" CornerRadius="6" Background="#FF0D1422" BorderBrush="#4494A3B8" BorderThickness="1"
                                        Padding="6,0" Margin="0,0,0,8">
                                    <Border CornerRadius="7" Background="#DD0A0F1C" BorderBrush="#55818CF8" BorderThickness="1"
                                            Padding="6,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Border CornerRadius="4" Background="#1DFFFFFF" Padding="5,2" Margin="0,0,4,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="2" Height="12" CornerRadius="1" Background="#4ADE80" Margin="0,0,3,0" />
                                                    <TextBlock Text="144" FontSize="10" FontWeight="Bold" Foreground="#4ADE80" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <Border CornerRadius="4" Background="#15FFFFFF" Padding="5,2" Width="44">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="CPU 42%" FontSize="7.5" FontWeight="SemiBold" Foreground="#E2E8F0" />
                                                    <Border Height="2.5" CornerRadius="1" Background="#28FFFFFF" Margin="0,2,0,0">
                                                        <Border Width="16" CornerRadius="1" Background="#38BDF8" HorizontalAlignment="Left" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Border>
                                <TextBlock Text="{loc:Loc 'Шкалы нагрузки'}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Loc 'Плитки с прогресс-барами'}" FontSize="10.5" Foreground="{DynamicResource App.TextMuted}"
                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Опция только для стиля Телеметрия -->
                    <Border x:Name="TelemetryDetailsRow" Margin="0,0,0,16" Padding="12,10" CornerRadius="8"
                            Background="{DynamicResource App.SurfaceAlt}" BorderBrush="{DynamicResource App.BorderSubtle}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{loc:Loc 'По ядрам CPU и подробно о GPU'}" Style="{StaticResource ItemTitleText}" />
                                <TextBlock Text="{loc:Loc 'Построчный вывод загрузки каждого ядра процессора и частот/памяти видеокарты. Доступно только в стиле «Телеметрия».'}"
                                           Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="ShowPerCoreCpuCheck" Content="{loc:Loc 'Ядра CPU'}" Margin="0,0,12,0"
                                          VerticalAlignment="Center" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
                                <CheckBox x:Name="ShowDetailedGpuCheck" Content="{loc:Loc 'Детали GPU'}" Margin="0,0,12,0"
                                          VerticalAlignment="Center" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
                                <CheckBox x:Name="ShowFramerateGraphCheck" Content="{loc:Loc 'График FPS'}"
                                          VerticalAlignment="Center" Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Позиция на экране'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Угол экрана, верхний центр или свободное перетаскивание мышью.'}" Style="{StaticResource ItemDescriptionText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox x:Name="PositionCombo" Width="220" FontSize="13" VerticalAlignment="Center"
                                      SelectionChanged="AnySelectionChanged" />
                            <ui:ToggleSwitch x:Name="DragPositionToggle" Margin="10,0,0,0" VerticalAlignment="Center"
                                             ToolTip="{loc:Loc 'Настроить позицию мышью (перетащите оверлей)'}"
                                             Checked="DragPositionToggle_Changed" Unchecked="DragPositionToggle_Changed" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{loc:Loc 'Расположение элементов'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Компактная строка в одну линию или подробная вертикальная таблица.'}" Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                            <TextBlock x:Name="LayoutTelemetryHint"
                                       Text="{loc:Loc 'В стиле «Телеметрия» данные всегда идут построчно сверху вниз.'}"
                                       FontSize="11.5" Foreground="{DynamicResource App.IconAccent}" Margin="0,2,0,0" Visibility="Collapsed" />
                        </StackPanel>
                        <ComboBox x:Name="LayoutCombo" Grid.Column="1" Width="220" FontSize="13" VerticalAlignment="Center"
                                  SelectionChanged="AnySelectionChanged" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Размер оверлея'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Масштаб текста и отступов HUD.'}" Style="{StaticResource ItemDescriptionText}" />
                        </StackPanel>
                        <ComboBox x:Name="ScaleCombo" Grid.Column="1" Width="220" FontSize="13" VerticalAlignment="Center"
                                  SelectionChanged="AnySelectionChanged" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Частота обновления'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Более редкое обновление снижает нагрузку на процессор.'}" Style="{StaticResource ItemDescriptionText}" />
                        </StackPanel>
                        <ComboBox x:Name="IntervalCombo" Grid.Column="1" Width="220" FontSize="13" VerticalAlignment="Center"
                                  SelectionChanged="AnySelectionChanged" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Цвета текущей темы приложения'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Если выключено, используется классический тёмный полупрозрачный игровой фон.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="UseAppThemeToggle" Grid.Column="1" VerticalAlignment="Center"
                                         Checked="AnySettingChanged" Unchecked="AnySettingChanged" />
                    </Grid>

                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{loc:Loc 'Непрозрачность фона'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock x:Name="OpacityLabel" HorizontalAlignment="Right"
                                       Style="{StaticResource ItemDescriptionText}" FontWeight="SemiBold" />
                        </Grid>
                        <Slider x:Name="OpacitySlider" Minimum="20" Maximum="95" TickFrequency="5" IsSnapToTickEnabled="True"
                                ValueChanged="OpacitySlider_ValueChanged" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
