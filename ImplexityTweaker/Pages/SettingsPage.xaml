<Page x:Class="ImplexityTweaker.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Settings"
      Foreground="{DynamicResource App.Text}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Настройки программы" FontSize="32" FontWeight="Bold" />
            <TextBlock Text="Тема оформления, сохранение параметров в приложении."
                       Foreground="{DynamicResource App.TextMuted}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,16" />

            <ui:Card Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Тема приложения" FontWeight="Bold" FontSize="16" Margin="0,0,0,4" />
                    <TextBlock Text="Внешний вид приложения."
                               FontSize="12"
                               Foreground="{DynamicResource App.TextMuted}"
                               Margin="0,0,0,16" />
                    <ComboBox x:Name="ThemeCombo" MinWidth="320" SelectionChanged="ThemeCombo_SelectionChanged" />
                    <ui:Button Content="Сохранить и применить тему" Appearance="Primary" Click="SaveTheme_Click" HorizontalAlignment="Left" Padding="20,8" Margin="0,14,0,0" />
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Файл конфигурации" FontWeight="Bold" FontSize="16" Margin="0,0,0,4" />
                    <TextBlock Text="Экспортируйте свои настройки в файл .implexity, чтобы перенести их на другой компьютер или сохранить резервную копию. Импорт загрузит настройки из такого файла."
                               FontSize="12"
                               Foreground="{DynamicResource App.TextMuted}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Экспорт настроек (.implexity)" Appearance="Primary" Click="ExportConfig_Click" Padding="20,8" Margin="0,0,10,0" />
                        <ui:Button Content="Импорт настроек (.implexity)" Appearance="Secondary" Click="ImportConfig_Click" Padding="20,8" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="О программе" FontWeight="Bold" FontSize="16" Margin="0,0,0,4" />
                    <TextBlock Text="Implexity Tweaker — набор модулей для настройки Windows 10 и 11. Официальный Telegram канал твикера https://t.me/implexityfun"
                               FontSize="12"
                               Foreground="{DynamicResource App.TextMuted}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />
                    <TextBlock Text="Версия 1.3 · WPF-UI Fluent · .NET 8"
                               FontSize="12"
                               Foreground="{DynamicResource App.TextMuted}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </ui:Card>

            <ui:Button Content="Назад" Appearance="Secondary" Click="Back_Click" HorizontalAlignment="Left" Padding="20,8" Margin="0,20,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>