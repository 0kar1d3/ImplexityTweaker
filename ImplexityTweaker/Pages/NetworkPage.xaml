<Page x:Class="ImplexityTweaker.Pages.NetworkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:ImplexityTweaker.Localization"
      Title="Network"
      Foreground="{DynamicResource App.Text}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <TextBlock Text="{loc:Loc 'Сетевые настройки'}" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{loc:Loc 'Сетевые твики Windows, сброс стека, IPv6, DNS, тест задержки, пароли Wi-Fi и блокировка телеметрии.'}"
                       Style="{StaticResource PageDescriptionText}"
                       Margin="0,8,0,16" />

            <ui:Card Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="{loc:Loc 'Сеть и задержка'}" Style="{StaticResource CardHeaderText}" Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Wifi124" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Отключить алгоритм Nagle'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Уменьшает задержку при передаче мелких пакетов (снижает пинг).'}"
                                       Style="{StaticResource ItemDescriptionText}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="DisableNagleToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="DisableNagleToggle_Toggled" Unchecked="DisableNagleToggle_Toggled" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowAutofitContent24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Отключить TCP Auto-Tuning'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Помогает стабилизировать пинг и устранить микро-лаги в онлайн-играх.'}"
                                       Style="{StaticResource ItemDescriptionText}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="DisableAutoTuningToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="DisableAutoTuningToggle_Toggled" Unchecked="DisableAutoTuningToggle_Toggled" />
                    </Grid>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowTrendingSettings24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Приоритезация сетевого трафика (QoS)'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Снижает сетевую задержку: мгновенная отправка ACK и DSCP-метка приоритета для игрового трафика.'}"
                                       Style="{StaticResource ItemDescriptionText}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="PrioritizeBurstToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="PrioritizeBurstToggle_Toggled" Unchecked="PrioritizeBurstToggle_Toggled" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowSyncCheckmark24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Мгновенная отправка ACK-пакетов'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Подтверждения TCP отправляются сразу, без накопления — снижает пинг в онлайн-играх.'}"
                                       Style="{StaticResource ItemDescriptionText}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="TcpAckFrequencyToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="TcpAckFrequencyToggle_Toggled" Unchecked="TcpAckFrequencyToggle_Toggled" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource App.SurfaceAlt}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Width="44" Height="44"
                            VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="ArrowTrendingSettings24" FontSize="22" Foreground="{DynamicResource App.IconAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{loc:Loc 'Тест задержки'}" Style="{StaticResource ItemTitleText}" />
                        <TextBlock Text="{loc:Loc 'Проверяет пинг, джиттер и потери до популярных DNS-серверов.'}"
                                   Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" Margin="0,4,0,14" />
                        <ui:Button Content="{loc:Loc 'Запустить тест'}" Appearance="Primary" Click="Ping_Click"
                                   HorizontalAlignment="Left" Padding="20,8" />
                        <StackPanel x:Name="PingHost" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource App.SurfaceAlt}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Width="44" Height="44"
                            VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="ArrowClockwise28" FontSize="22" Foreground="{DynamicResource App.IconAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{loc:Loc 'Сброс сетевого стека'}" Style="{StaticResource ItemTitleText}" />
                        <TextBlock Text="{loc:Loc 'Сбрасывает Winsock, TCP/IP, IPv6, DNS и ARP. Помогает, когда интернет «пропал». Требуется перезагрузка.'}"
                                   Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" Margin="0,4,0,14" />
                        <ui:Button Content="{loc:Loc 'Сбросить стек'}" Appearance="Primary" Click="ResetStack_Click"
                                   HorizontalAlignment="Left" Padding="20,8" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="{loc:Loc 'Сетевые параметры'}" Style="{StaticResource CardHeaderText}" Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Globe24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Отключить IPv6'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Иногда убирает проблемы с подключением и задержки. Оставьте включённым, если не уверены.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="Ipv6Toggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="Ipv6Toggle_Toggled" Unchecked="Ipv6Toggle_Toggled" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource App.SurfaceAlt}" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc 'Блокировка телеметрии через hosts'}" Style="{StaticResource ItemTitleText}" />
                            <TextBlock Text="{loc:Loc 'Добавляет домены телеметрии Microsoft в hosts. Отключается в любой момент — остальные записи не трогаются.'}"
                                       Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="HostsToggle" Grid.Column="2" VerticalAlignment="Center"
                                         Checked="HostsToggle_Toggled" Unchecked="HostsToggle_Toggled" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- ===== DNS-серверы ===== -->
            <ui:Card Padding="20" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource App.SurfaceAlt}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Width="44" Height="44"
                            VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="Globe24" FontSize="22" Foreground="{DynamicResource App.IconAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{loc:Loc 'DNS-серверы'}" Style="{StaticResource ItemTitleText}" />
                        <TextBlock Text="{loc:Loc 'Быстрая смена DNS-серверов. Может снизить задержку и улучшить подключение к серверам игр.'}"
                                   Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <TextBlock x:Name="DnsCurrentText" Style="{StaticResource ItemDescriptionText}"
                                   TextWrapping="Wrap" Margin="0,0,0,10" />
                        <ComboBox x:Name="DnsCombo" MinWidth="320" HorizontalAlignment="Left" FontSize="13" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="{loc:Loc 'Применить DNS'}" Appearance="Primary" Click="ApplyDns_Click" Padding="20,8" Margin="0,0,8,0" />
                            <ui:Button Content="{loc:Loc 'Автоматически (DHCP)'}" Appearance="Secondary" Click="ResetDns_Click" Padding="20,8" />
                            <ui:Button Content="{loc:Loc 'Обновить'}" Appearance="Transparent" Click="RefreshDns_Click" Padding="16,8" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource App.SurfaceAlt}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Width="44" Height="44"
                            VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="Wifi124" FontSize="22" Foreground="{DynamicResource App.IconAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="{loc:Loc 'Пароли Wi-Fi'}" Style="{StaticResource ItemTitleText}" />
                        <TextBlock Text="{loc:Loc 'Показывает сохранённые сети и их пароли. Пароль можно скопировать в буфер обмена.'}"
                                   Style="{StaticResource ItemDescriptionText}" TextWrapping="Wrap" Margin="0,4,0,14" />
                        <ui:Button Content="{loc:Loc 'Показать сети и пароли'}" Appearance="Secondary" Click="Wifi_Click"
                                   HorizontalAlignment="Left" Padding="20,8" />
                        <StackPanel x:Name="WifiHost" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>
