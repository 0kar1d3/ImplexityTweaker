<Page x:Class="ImplexityTweaker.Pages.OptimizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Optimization"
      Foreground="{DynamicResource App.Text}">

    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ui:Card Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock FontSize="28" FontWeight="Bold" Margin="0,0,0,5">
                            <Run Text="Оптимизация для CS2"/>
                        </TextBlock>
                        <TextBlock Text="Оптимизация Windows для Counter-Strike 2 и других игр." 
                                   Foreground="Gray" Margin="0,0,0,0"/>
                    </StackPanel>
                </ui:Card>

                
                <ui:Card Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Графика и GPU" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>

                        <ui:ToggleSwitch x:Name="DisableFsoToggle" 
                                         Content="Отключить Full Screen Optimizations (FSO)"
                                         Checked="DisableFsoToggle_Toggled"
                                         Unchecked="DisableFsoToggle_Toggled"
                                         Margin="0,0,0,10"/>
                        <TextBlock Text="Отключает оптимизацию полного экрана, что понижает задержку в игре." 
                                   FontSize="12" Foreground="Gray" Margin="15,0,0,15"/>

                        <ui:ToggleSwitch x:Name="DisableMpoToggle" 
                                         Content="Отключить Multi-Plane Overlay (MPO)"
                                         Checked="DisableMpoToggle_Toggled"
                                         Unchecked="DisableMpoToggle_Toggled"
                                         Margin="0,0,0,10"/>
                        <TextBlock Text="Устраняет микро-фризы, мерцание экрана и статтеры в играх" 
                                   FontSize="12" Foreground="Gray" Margin="15,0,0,15"/>

                        <ui:ToggleSwitch x:Name="DisableGameDvrToggle" 
                                         Content="Отключить Game DVR (Xbox Game Bar)"
                                         Checked="DisableGameDvrToggle_Toggled"
                                         Unchecked="DisableGameDvrToggle_Toggled"
                                         Margin="0,0,0,10"/>
                        <TextBlock Text="Освобождает ресурсы, которые Game Bar занимает в фоне" 
                                   FontSize="12" Foreground="Gray" Margin="15,0,0,15"/>

                        <ui:ToggleSwitch x:Name="HighPriorityToggle" 
                                         Content="Установить высокий приоритет для CS2"
                                         Checked="HighPriorityToggle_Toggled"
                                         Unchecked="HighPriorityToggle_Toggled"
                                         Margin="0,0,0,10"/>
                        <TextBlock Text="CS2 будет получать больше ресурсов процессора" 
                                   FontSize="12" Foreground="Gray" Margin="15,0,0,0"/>
                    </StackPanel>
                </ui:Card>

                
                <ui:Card Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Сеть и задержка" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>

                        <ui:ToggleSwitch x:Name="DisableNagleToggle" 
                                         Content="Отключить алгоритм Nagle"
                                         Checked="DisableNagleToggle_Toggled"
                                         Unchecked="DisableNagleToggle_Toggled"
                                         Margin="0,0,0,10"/>
                        <TextBlock Text="Уменьшает задержку при передаче мелких пакетов (снижает пинг)" 
                                   FontSize="12" Foreground="Gray" Margin="15,0,0,15"/>

                        <ui:ToggleSwitch x:Name="DisableAutoTuningToggle" 
                                         Content="Отключить TCP Auto-Tuning"
                                         Checked="DisableAutoTuningToggle_Toggled"
                                         Unchecked="DisableAutoTuningToggle_Toggled"
                                         Margin="0,0,0,10"/>
                        <TextBlock Text="Помогает стабилизировать пинг и устранить микро-лаги в онлайн-играх (у некоторых может вызвать проблемы)." 
                                   FontSize="12" Foreground="Gray" Margin="15,0,0,15"/>

                        <ui:ToggleSwitch x:Name="PrioritizeBurstToggle" 
                                         Content="Игровой приоритет сети"
                                         Checked="PrioritizeBurstToggle_Toggled"
                                         Unchecked="PrioritizeBurstToggle_Toggled"
                                         Margin="0,0,0,10"/>
                        <TextBlock Text="Приоритизирует игровые данные над фоновыми процессами" 
                                   FontSize="12" Foreground="Gray" Margin="15,0,0,0"/>
                    </StackPanel>
                </ui:Card>

                
                <ui:Card Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Производительность системы" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>

                        <ui:ToggleSwitch x:Name="DisableVisualEffectsToggle" 
                                         Content="Отключить визуальные эффекты Windows"
                                         Checked="DisableVisualEffectsToggle_Toggled"
                                         Unchecked="DisableVisualEffectsToggle_Toggled"
                                         Margin="0,0,0,10"/>
                        <TextBlock Text="Отключает анимации и прозрачность для экономии ресурсов" 
                                   FontSize="12" Foreground="Gray" Margin="15,0,0,15"/>

                        <ui:ToggleSwitch x:Name="DisableWindowsAnimationToggle" 
                                         Content="Отключить анимации окон"
                                         Checked="DisableWindowsAnimationToggle_Toggled"
                                         Unchecked="DisableWindowsAnimationToggle_Toggled"
                                         Margin="0,0,0,10"/>
                        <TextBlock Text="Минимизирует задержку при переключении окон" 
                                   FontSize="12" Foreground="Gray" Margin="15,0,0,15"/>

                        <ui:ToggleSwitch x:Name="DisableBackgroundAppsToggle" 
                                         Content="Отключить фоновые приложения"
                                         Checked="DisableBackgroundAppsToggle_Toggled"
                                         Unchecked="DisableBackgroundAppsToggle_Toggled"
                                         Margin="0,0,0,10"/>
                        <TextBlock Text="Отключает только ненужные встроенные приложения." 
                                   FontSize="12" Foreground="Gray" Margin="15,0,0,0"/>
                    </StackPanel>
                </ui:Card>

                
                <ui:Card Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Обслуживание" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Очистить кэш шейдеров Steam и CS2"/>
                                <TextBlock Text="Помогает при микрофризах после обновлений" 
                                           FontSize="12" Foreground="Gray"/>
                            </StackPanel>
                            <ui:Button Grid.Column="1" Content="Очистить" 
                                       Appearance="Secondary" 
                                       Click="ClearCache_Click"
                                       Padding="20,8"/>
                        </Grid>

                        <Separator Margin="0,10" Background="{DynamicResource App.Border}"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Очистить временные файлы Windows"/>
                                <TextBlock Text="Удаляет временные файлы, которые могут замедлить систему" 
                                           FontSize="12" Foreground="Gray"/>
                            </StackPanel>
                            <ui:Button Grid.Column="1" Content="Очистить" 
                                       Appearance="Secondary" 
                                       Click="ClearTempFiles_Click"
                                       Padding="20,8"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                
                <ui:Card Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Параметры запуска CS2" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>
                        <TextBlock Text="Параметры уже заполнены под вашу систему. Скопируйте их в свойства запуска игры в Steam" 
                                   FontSize="12" Foreground="Gray" Margin="0,0,0,10"/>

                        <ui:TextBox x:Name="LaunchArgsBox" 
                                    Margin="0,0,0,10"
                                    MinHeight="60"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="True"
                                    IsReadOnly="True"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Скопировать в буфер обмена" VerticalAlignment="Center"/>
                            <ui:Button Grid.Column="1" Content="Копировать" 
                                       Appearance="Primary" 
                                       Click="CopyLaunchArgs_Click"
                                       Padding="20,8"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                
                <ui:Card Padding="20" Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Информация" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <TextBlock Text="• Изменения требуют перезагрузки компьютера для полного эффекта" 
                                   Margin="0,0,0,5" FontSize="12"/>
                        <TextBlock Text="• Рекомендуется создать точку восстановления перед применением твиков" 
                                   Margin="0,0,0,5" FontSize="12"/>
                        <TextBlock Text="• Используйте все твики на свой собственный риск" 
                                   FontSize="12"/>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>     
    </Grid>
</Page>