<Window x:Class="ImplexityTweaker.Windows.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:ImplexityTweaker.Localization"
        Title="Implexity Tweaker"
        Width="300"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Foreground="{DynamicResource App.Text}"
        FontFamily="Segoe UI Variable, Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="TrayItemButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{DynamicResource App.Text}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrayDangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource TrayItemButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{DynamicResource App.Text}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.DangerSoft}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            Background="{DynamicResource App.Surface}"
            BorderBrush="{DynamicResource App.Border}"
            BorderThickness="1"
            CornerRadius="12"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect x:Name="MenuShadow" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.32" Color="#000000" />
        </Border.Effect>

        <StackPanel x:Name="MenuRoot">
            <!-- Шапка -->
            <Border Background="{DynamicResource App.SurfaceAlt}"
                    BorderBrush="{DynamicResource App.Border}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    Padding="12,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Source="/icon_rounded.png" Width="20" Height="20"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1"
                                   Text="Implexity Tweaker"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Text}"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="2"
                                Background="{DynamicResource App.Surface}"
                                BorderBrush="{DynamicResource App.Border}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="7,2"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="RamPercentText"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.IconAccent}" />
                        </Border>
                    </Grid>

                    <TextBlock x:Name="ActiveFeaturesText"
                               FontSize="11"
                               Foreground="{DynamicResource App.TextMuted}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <!-- Пункты меню -->
            <StackPanel Margin="6">
                <Button Style="{StaticResource TrayItemButton}" Click="OpenApp_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Open24" FontSize="15" Foreground="{DynamicResource App.IconAccent}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{loc:Loc 'Открыть Implexity Tweaker'}"
                                   FontSize="13" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <Separator Margin="6,4" Background="{DynamicResource App.Border}" />

                <Button Style="{StaticResource TrayItemButton}" Click="CleanRam_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Rocket24" FontSize="15" Foreground="{DynamicResource App.IconAccent}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{loc:Loc 'Очистить ОЗУ сейчас'}"
                                   FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <Button Style="{StaticResource TrayItemButton}" Click="OpenShutdownTimer_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="ClockToolbox20" FontSize="15" Foreground="{DynamicResource App.IconAccent}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{loc:Loc 'Таймер выключения'}"
                                   FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <Separator Margin="6,4" Background="{DynamicResource App.Border}" />

                <Button Style="{StaticResource TrayItemButton}" Click="ToggleAutostart_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="ArrowSyncCheckmark24" FontSize="15" Foreground="{DynamicResource App.IconAccent}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{loc:Loc 'Запускать в фоне с Windows'}"
                                   FontSize="13" Margin="6,0,8,0" VerticalAlignment="Center" />
                        <Border x:Name="AutostartPill" Grid.Column="2" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                            <TextBlock x:Name="AutostartPillText" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Button>

                <Separator Margin="6,4" Background="{DynamicResource App.Border}" />

                <Button Style="{StaticResource TrayDangerButton}" Click="ExitApp_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="DismissCircle24" FontSize="15" Foreground="{DynamicResource App.Danger}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{loc:Loc 'Выйти полностью'}"
                                   FontSize="13" Foreground="{DynamicResource App.Danger}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
