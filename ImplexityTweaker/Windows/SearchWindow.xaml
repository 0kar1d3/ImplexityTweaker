<Window x:Class="ImplexityTweaker.Windows.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:ImplexityTweaker.Localization"
        Title="{loc:Loc 'Поиск по твикеру'}"
        Icon="/icon_rounded.png"
        Width="680"
        Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Foreground="{DynamicResource App.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI Variable, Segoe UI">

    <Border Margin="14"
            Background="{DynamicResource App.Surface}"
            BorderBrush="{DynamicResource App.Border}"
            BorderThickness="1"
            CornerRadius="12"
            SnapsToDevicePixels="True"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.48" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Поле поиска (Command Palette) -->
            <Border Grid.Row="0"
                    Background="{DynamicResource App.SurfaceAlt}"
                    BorderBrush="{DynamicResource App.BorderSubtle}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Symbol="Search24"
                                   FontSize="18"
                                   Foreground="{DynamicResource App.IconAccent}"
                                   Margin="2,0,12,0"
                                   VerticalAlignment="Center" />

                    <TextBox x:Name="QueryBox"
                             Grid.Column="1"
                             FontSize="14.5"
                             Padding="10,8"
                             TextChanged="QueryBox_TextChanged" />

                    <ui:Button x:Name="CloseButton"
                               Grid.Column="2"
                               Content="{loc:Loc 'Закрыть'}"
                               Appearance="Secondary"
                               Padding="12,7"
                               Margin="10,0,0,0"
                               Click="Close_Click" />
                </Grid>
            </Border>

            <!-- Счётчик результатов -->
            <TextBlock x:Name="CountText"
                       Grid.Row="1"
                       Style="{StaticResource ItemDescriptionText}"
                       Margin="18,10,18,6" />

            <!-- Результаты -->
            <Grid Grid.Row="2" Margin="10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ResultList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8"
                                        Margin="0,2,0,0"
                                        CornerRadius="6"
                                        Cursor="Hand"
                                        Tag="{Binding}"
                                        MouseEnter="Result_MouseEnter"
                                        MouseLeave="Result_MouseLeave"
                                        MouseLeftButtonUp="Result_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource App.Hover}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource App.NavActiveBg}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="3" Height="18"
                                                CornerRadius="1.5"
                                                Background="{DynamicResource App.Accent}"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <Border Grid.Column="1"
                                                Background="{DynamicResource App.SurfaceAlt}"
                                                BorderBrush="{DynamicResource App.BorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Width="32" Height="32"
                                                VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="{Binding Icon}"
                                                           FontSize="16"
                                                           Foreground="{DynamicResource App.IconAccent}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="2" Margin="12,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}"
                                                       Style="{StaticResource ItemDescriptionText}"
                                                       Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding State}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource App.TextMuted}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyText"
                           Text="{loc:Loc 'Ничего не найдено. Попробуйте другое слово: «сеть», «память», «fps».'}"
                           Style="{StaticResource ItemDescriptionText}"
                           Margin="10,8,10,0"
                           VerticalAlignment="Top"
                           Visibility="Collapsed" />
            </Grid>

            <!-- Подсказка по клавишам -->
            <Border Grid.Row="3"
                    Background="{DynamicResource App.SurfaceAlt}"
                    BorderBrush="{DynamicResource App.BorderSubtle}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12"
                    Padding="18,10">
                <TextBlock x:Name="HintText"
                           Style="{StaticResource ItemDescriptionText}" />
            </Border>
        </Grid>
    </Border>

</Window>
