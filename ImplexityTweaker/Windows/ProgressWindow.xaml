<Window x:Class="ImplexityTweaker.Windows.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:ImplexityTweaker.Localization"
        Title="{loc:Loc 'Применение настроек'}"
        Icon="/icon_rounded.png"
        Width="480"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Foreground="{DynamicResource App.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI Variable, Segoe UI">

    <Border Margin="14"
            Background="{DynamicResource App.Surface}"
            BorderBrush="{DynamicResource App.Border}"
            BorderThickness="1"
            CornerRadius="12"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid Margin="22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Шапка: иконка, заголовок и текущий шаг -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="40" Height="40" CornerRadius="8"
                        BorderBrush="{DynamicResource App.BorderSubtle}"
                        BorderThickness="1"
                        Background="{DynamicResource App.SurfaceAlt}"
                        VerticalAlignment="Top">
                    <ui:SymbolIcon Symbol="Rocket24" FontSize="19"
                                   Foreground="{DynamicResource App.IconAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Text}" />
                    <TextBlock x:Name="StepText"
                               FontSize="12.5"
                               Foreground="{DynamicResource App.TextMuted}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <!-- Процент -->
            <TextBlock x:Name="PercentText"
                       Grid.Row="1"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource App.IconAccent}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />

            <ProgressBar x:Name="Progress"
                         Grid.Row="2"
                         Height="6"
                         Margin="0,8,0,0"
                         Minimum="0"
                         Maximum="100"
                         BorderThickness="0"
                         Background="{DynamicResource App.Border}"
                         Foreground="{DynamicResource App.Accent}"
                         SnapsToDevicePixels="True" />

            <!-- Кнопка отмены (показывается только для отменяемых операций) -->
            <ui:Button x:Name="CancelButton"
                       Grid.Row="3"
                       Content="{loc:Loc 'Отмена'}"
                       Appearance="Secondary"
                       HorizontalAlignment="Right"
                       Padding="18,7"
                       Margin="0,16,0,0"
                       Visibility="Collapsed"
                       Click="CancelButton_Click" />
        </Grid>
    </Border>
</Window>
