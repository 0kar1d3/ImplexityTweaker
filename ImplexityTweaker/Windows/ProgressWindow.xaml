<Window x:Class="ImplexityTweaker.Windows.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:ImplexityTweaker.Localization"
        Title="{loc:Loc 'Применение настроек'}"
        Icon="/icon_rounded.png"
        Width="470"
        Height="200"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource App.SurfaceAlt}"
        Foreground="{DynamicResource App.Text}"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Border Background="{DynamicResource App.SurfaceAlt}"
            BorderBrush="{DynamicResource App.Border}"
            BorderThickness="1"
            CornerRadius="14"
            SnapsToDevicePixels="True">
        <Grid Margin="22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Шапка: акцентный маркер + заголовок и текущий шаг -->
            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,16">
                <Border Width="42" Height="42" CornerRadius="10"
                        BorderBrush="{DynamicResource App.IconAccent}"
                        BorderThickness="1"
                        Background="{DynamicResource App.Surface}" />
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource App.Text}" />
                    <TextBlock x:Name="StepText"
                               FontSize="12"
                               Foreground="{DynamicResource App.TextMuted}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Процент + полоса прогресса -->
            <TextBlock x:Name="PercentText"
                       Grid.Row="1"
                       FontSize="12"
                       Foreground="{DynamicResource App.TextMuted}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />

            <ProgressBar x:Name="Progress"
                         Grid.Row="2"
                         Height="8"
                         Margin="0,10,0,0"
                         Minimum="0"
                         Maximum="100"
                         BorderThickness="0"
                         Background="{DynamicResource App.Border}"
                         Foreground="{DynamicResource App.IconAccent}"
                         SnapsToDevicePixels="True" />

            <!-- Кнопка отмены (показывается только для отменяемых операций) -->
            <ui:Button x:Name="CancelButton"
                       Grid.Row="3"
                       Content="{loc:Loc 'Отмена'}"
                       Appearance="Secondary"
                       HorizontalAlignment="Right"
                       Padding="20,8"
                       Margin="0,16,0,0"
                       Visibility="Collapsed"
                       Click="CancelButton_Click" />
        </Grid>
    </Border>
</Window>
