<Window x:Class="ImplexityTweaker.Windows.DisksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:ImplexityTweaker.Localization"
        Title="{loc:Loc 'Состояние накопителей (SMART)'}"
        Icon="/icon_rounded.png"
        Width="680" Height="620"
        MinWidth="540" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource App.Text}"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Border Background="{DynamicResource App.Background}"
            BorderBrush="{DynamicResource App.Border}"
            BorderThickness="1">
        <Grid Margin="20,16,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Шапка: иконка, заголовок, кнопка обновления -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource App.SurfaceAlt}"
                        BorderBrush="{DynamicResource App.Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Width="46" Height="46"
                        VerticalAlignment="Top">
                    <ui:SymbolIcon Symbol="Storage24" FontSize="22" Foreground="{DynamicResource App.IconAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc 'Состояние накопителей (SMART)'}" FontSize="18" FontWeight="Bold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource ItemDescriptionText}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <ui:Button Grid.Column="2" x:Name="RefreshButton" Content="{loc:Loc 'Обновить'}"
                           Appearance="Secondary" Click="Refresh_Click" Padding="16,8"
                           VerticalAlignment="Top" />
            </Grid>

            <!-- Шкала оценки -->
            <TextBlock Grid.Row="1" x:Name="LegendText" Style="{StaticResource ItemDescriptionText}"
                       Margin="0,12,0,0" />

            <!-- Список накопителей -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="DisksHost" />
                </ScrollViewer>

                <ui:ProgressRing x:Name="LoadingIndicator" IsIndeterminate="True" Width="32" Height="32"
                                 HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                                 Visibility="Collapsed" />

                <TextBlock x:Name="InfoText" Style="{StaticResource ItemDescriptionText}"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed" />
            </Grid>

            <!-- Итог -->
            <TextBlock Grid.Row="3" x:Name="SummaryText" Style="{StaticResource ItemDescriptionText}"
                       Margin="0,12,0,0" />
        </Grid>
    </Border>
</Window>
