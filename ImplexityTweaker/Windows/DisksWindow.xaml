<Window x:Class="ImplexityTweaker.Windows.DisksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:ImplexityTweaker.Localization"
        Title="{loc:Loc 'Состояние накопителей (SMART)'}"
        Icon="/icon_rounded.png"
        Width="720" Height="640"
        MinWidth="540" MinHeight="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource App.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI Variable, Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Margin="14"
            Background="{DynamicResource App.Surface}"
            BorderBrush="{DynamicResource App.Border}"
            BorderThickness="1"
            CornerRadius="12"
            SnapsToDevicePixels="True"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid Margin="22,18,22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Шапка: иконка, заголовок, обновить, закрыть -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource SettingIconBox}"
                        Width="44" Height="44"
                        VerticalAlignment="Top">
                    <ui:SymbolIcon Symbol="Storage24" FontSize="22" Foreground="{DynamicResource App.IconAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc 'Состояние накопителей (SMART)'}" FontSize="18" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource ItemDescriptionText}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <ui:Button x:Name="RefreshButton" Content="{loc:Loc 'Обновить'}"
                               Appearance="Secondary" Click="Refresh_Click" Padding="14,7"
                               Margin="0,0,8,0" />
                    <ui:Button Content="{loc:Loc 'Закрыть'}"
                               Appearance="Secondary" Click="Close_Click" Padding="14,7" />
                </StackPanel>
            </Grid>

            <!-- Шкала оценки -->
            <TextBlock Grid.Row="1" x:Name="LegendText" Style="{StaticResource ItemDescriptionText}"
                       Margin="0,12,0,0" />

            <!-- Список накопителей -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="DisksHost" />
                </ScrollViewer>

                <ui:ProgressRing x:Name="LoadingIndicator" IsIndeterminate="True" Width="32" Height="32"
                                 HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                                 Visibility="Collapsed" />

                <TextBlock x:Name="InfoText" Style="{StaticResource ItemDescriptionText}"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed" />
            </Grid>

            <!-- Итог -->
            <TextBlock Grid.Row="3" x:Name="SummaryText" Style="{StaticResource ItemDescriptionText}"
                       Margin="0,12,0,0" />
        </Grid>
    </Border>
</Window>
