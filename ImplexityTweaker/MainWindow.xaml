<ui:UiWindow x:Class="ImplexityTweaker.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:ImplexityTweaker.Localization"
             Title="Implexity Tweaker"
             Icon="/icon_rounded.png"
             Height="720"
             Width="1120"
             MinHeight="560"
             MinWidth="900"
             WindowStartupLocation="CenterScreen"
             ExtendsContentIntoTitleBar="True"
             WindowBackdropType="Mica"
             Background="{DynamicResource App.Background}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Implexity Tweaker"
                     Icon="/icon_rounded.png"
                     Foreground="{DynamicResource App.Text}" />

        <Grid Grid.Row="1" Margin="20,8,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource App.SidebarBorder}" Padding="14,16">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="4,0,4,12">
                        <TextBlock Text="Implexity Tweaker"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource App.Text}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Гибкая настройка для Windows 10 / 11"
                                   x:Name="SidebarSubtitle"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource App.TextMuted}" />
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Margin="4,10,4,0" Padding="8" Background="{DynamicResource App.SurfaceAlt}"
                            BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="10">
                        <StackPanel>

                            <!-- Авторизованный аккаунт: клик открывает профиль на сайте -->
                            <Border x:Name="AccountWidget" Cursor="Hand" MouseLeftButtonUp="AccountWidget_Click"
                                    ToolTip="{loc:Loc 'Открыть профиль на сайте'}" Visibility="Collapsed">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="10" />
                                        <Setter Property="Padding" Value="8" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource App.Hover}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Круглая аватарка -->
                                    <Grid Width="42" Height="42" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}"
                                                BorderThickness="1" CornerRadius="21">
                                            <ui:SymbolIcon Symbol="Person24" FontSize="20" Foreground="{DynamicResource App.IconAccent}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush x:Name="AccountAvatarBrush" Stretch="UniformToFill"
                                                            RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <!-- Бейдж префикса, как на сайте -->
                                            <Border x:Name="AccountPrefixBadge" CornerRadius="5" Padding="5,1.5"
                                                    Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed">
                                                <TextBlock x:Name="AccountPrefix" FontSize="10" FontWeight="Bold" Text="⚡ " />
                                            </Border>
                                            <TextBlock x:Name="AccountName" FontWeight="SemiBold" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="AccountNumber" FontSize="11" Foreground="{DynamicResource App.TextMuted}" />
                                    </StackPanel>

                                    <ui:SymbolIcon Grid.Column="2" Symbol="ArrowRight24" FontSize="14"
                                                   Foreground="{DynamicResource App.TextMuted}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Не авторизован: кнопка «Войти» -->
                            <Button x:Name="LoginButton" Click="LoginButton_Click"
                                    Style="{StaticResource FluentSystemButton}" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Person24" FontSize="16" Foreground="{DynamicResource App.IconAccent}"
                                                   VerticalAlignment="Center" />
                                    <TextBlock x:Name="LoginButtonText" Text="{loc:Loc 'Войти'}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="NavButtonHost" Margin="0,0,4,0" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource App.ContentBorder}" Padding="0">
                <Frame x:Name="RootFrame"
                       NavigationUIVisibility="Hidden"
                       Background="Transparent" />
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="20,12,20,16"
                Padding="14,10"
                Background="{DynamicResource App.SurfaceAlt}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <ui:Button x:Name="RestartExplorerBtn" Appearance="Transparent"
                               Content="⟲  Перезапустить проводник"
                               Foreground="{DynamicResource App.Text}"
                               Click="RestartExplorer_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:Button x:Name="OpenSettingsBtn" Appearance="Transparent"
                               Content="⚙  Настройки / О программе"
                               Foreground="{DynamicResource App.Text}"
                               Margin="8,0,0,0"
                               Click="OpenSettings_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:UiWindow>
